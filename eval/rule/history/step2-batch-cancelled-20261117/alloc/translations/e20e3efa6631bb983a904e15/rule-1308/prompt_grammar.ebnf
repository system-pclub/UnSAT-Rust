(* Generated concrete EBNF. Every field, tuple position and enum tag is a literal. *)
(* $1 is value_layout: alloc::rc::Layout [argument]. *)
(* $2 is allocate: impl FnOnce (alloc::rc::Layout) -> core::result::Result < core::ptr::non_null::NonNull < [u8] > , core::alloc::AllocError > [argument]. *)
(* $3 is mem_to_rc_inner: impl FnOnce (* mut u8) -> * mut alloc::rc::RcInner < T > [argument]. *)
(* $4 is T: type metadata [type_parameter]. *)
(* $5 is result: core::result::Result < * mut alloc::rc::RcInner < T > , core::alloc::AllocError > [return_value]. *)
(* Bare identifier entries are comprehension locals only; scope and element types are checked separately. *)

(* E *)
e_term = (err_term, "[", "0", "]" | "(", e_term, ")") ;
(* MemoryAllocation *)
memory_allocation_term = (memory_storage_3_term, ".", "allocation" | memory_storage_8_term, ".", "allocation" | memory_storage_7_term, ".", "allocation" | memory_storage_6_term, ".", "allocation" | memory_storage_5_term, ".", "allocation" | memory_storage_4_term, ".", "allocation" | memory_storage_2_term, ".", "allocation" | memory_storage_1_term, ".", "allocation" | "(", memory_allocation_term, ")") ;
(* MemoryBool *)
memory_bool_term = (memory_storage_3_term, ".", "exists" | memory_storage_3_term, ".", "readable" | memory_storage_3_term, ".", "writable" | memory_storage_3_term, ".", "initialized" | memory_storage_3_term, ".", "valid" | memory_storage_8_term, ".", "exists" | memory_storage_8_term, ".", "readable" | memory_storage_8_term, ".", "writable" | memory_storage_8_term, ".", "initialized" | memory_storage_8_term, ".", "valid" | memory_storage_7_term, ".", "exists" | memory_storage_7_term, ".", "readable" | memory_storage_7_term, ".", "writable" | memory_storage_7_term, ".", "initialized" | memory_storage_7_term, ".", "valid" | memory_storage_6_term, ".", "exists" | memory_storage_6_term, ".", "readable" | memory_storage_6_term, ".", "writable" | memory_storage_6_term, ".", "initialized" | memory_storage_6_term, ".", "valid" | memory_allocation_term, ".", "exists" | memory_allocation_term, ".", "live" | memory_storage_5_term, ".", "exists" | memory_storage_5_term, ".", "readable" | memory_storage_5_term, ".", "writable" | memory_storage_5_term, ".", "initialized" | memory_storage_5_term, ".", "valid" | memory_storage_4_term, ".", "exists" | memory_storage_4_term, ".", "readable" | memory_storage_4_term, ".", "writable" | memory_storage_4_term, ".", "initialized" | memory_storage_4_term, ".", "valid" | memory_storage_2_term, ".", "exists" | memory_storage_2_term, ".", "readable" | memory_storage_2_term, ".", "writable" | memory_storage_2_term, ".", "initialized" | memory_storage_2_term, ".", "valid" | memory_storage_1_term, ".", "exists" | memory_storage_1_term, ".", "readable" | memory_storage_1_term, ".", "writable" | memory_storage_1_term, ".", "initialized" | memory_storage_1_term, ".", "valid" | "(", memory_bool_term, ")") ;
(* MemoryInteger *)
memory_integer_term = (memory_storage_3_term, ".", "start" | memory_storage_3_term, ".", "size" | memory_storage_3_term, ".", "end" | memory_storage_3_term, ".", "align" | memory_storage_3_term, ".", "readable_size" | memory_storage_3_term, ".", "writable_size" | memory_storage_8_term, ".", "start" | memory_storage_8_term, ".", "size" | memory_storage_8_term, ".", "end" | memory_storage_8_term, ".", "align" | memory_storage_8_term, ".", "readable_size" | memory_storage_8_term, ".", "writable_size" | memory_storage_7_term, ".", "start" | memory_storage_7_term, ".", "size" | memory_storage_7_term, ".", "end" | memory_storage_7_term, ".", "align" | memory_storage_7_term, ".", "readable_size" | memory_storage_7_term, ".", "writable_size" | memory_storage_6_term, ".", "start" | memory_storage_6_term, ".", "size" | memory_storage_6_term, ".", "end" | memory_storage_6_term, ".", "align" | memory_storage_6_term, ".", "readable_size" | memory_storage_6_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | memory_storage_5_term, ".", "start" | memory_storage_5_term, ".", "size" | memory_storage_5_term, ".", "end" | memory_storage_5_term, ".", "align" | memory_storage_5_term, ".", "readable_size" | memory_storage_5_term, ".", "writable_size" | memory_storage_4_term, ".", "start" | memory_storage_4_term, ".", "size" | memory_storage_4_term, ".", "end" | memory_storage_4_term, ".", "align" | memory_storage_4_term, ".", "readable_size" | memory_storage_4_term, ".", "writable_size" | memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | "(", memory_integer_term, ")") ;
(* MemoryStorage<E> *)
memory_storage_1_term = (e_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<T> *)
memory_storage_2_term = (t_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<alloc::rc::Layout> *)
memory_storage_3_term = (layout_term, ".", "$mem" | "(", memory_storage_3_term, ")") ;
(* MemoryStorage<core::result::Result::Err<T, E>> *)
memory_storage_4_term = (err_term, ".", "$mem" | "(", memory_storage_4_term, ")") ;
(* MemoryStorage<core::result::Result::Ok<T, E>> *)
memory_storage_5_term = (ok_term, ".", "$mem" | "(", memory_storage_5_term, ")") ;
(* MemoryStorage<core::result::Result<T, E>> *)
memory_storage_6_term = (result_term, ".", "$mem" | "(", memory_storage_6_term, ")") ;
(* MemoryStorage<impl FnOnce (* mut u8) -> * mut alloc::rc::RcInner < T >> *)
memory_storage_7_term = (opaque_1_term, ".", "$mem" | "(", memory_storage_7_term, ")") ;
(* MemoryStorage<impl FnOnce (alloc::rc::Layout) -> core::result::Result < core::ptr::non_null::NonNull < [u8] > , core::alloc::AllocError >> *)
memory_storage_8_term = (opaque_2_term, ".", "$mem" | "(", memory_storage_8_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* T *)
t_term = (ok_term, "[", "0", "]" | "(", t_term, ")") ;
(* alloc::rc::Layout *)
layout_term = ("$1" | "(", layout_term, ")") ;
(* core::result::Result::Err<T, E> *)
err_term = (result_term, ".", "Err" | "(", err_term, ")") ;
(* core::result::Result::Ok<T, E> *)
ok_term = (result_term, ".", "Ok" | "(", ok_term, ")") ;
(* core::result::Result<T, E> *)
result_term = ("$5" | "(", result_term, ")") ;
result_variant = ("\"Ok\"" | "'Ok'" | "\"Err\"" | "'Err'") ;
result_test = "is_variant", "(", result_term, ",", result_variant, ")" ;
(* impl FnOnce (* mut u8) -> * mut alloc::rc::RcInner < T > *)
opaque_1_term = ("$3" | "(", opaque_1_term, ")") ;
(* impl FnOnce (alloc::rc::Layout) -> core::result::Result < core::ptr::non_null::NonNull < [u8] > , core::alloc::AllocError > *)
opaque_2_term = ("$2" | "(", opaque_2_term, ")") ;
(* type parameter T *)
opaque_3_term = ("$4" | "(", opaque_3_term, ")") ;
typed_term = (e_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_storage_7_term | memory_storage_8_term | memory_string_term | t_term | layout_term | err_term | ok_term | result_term | opaque_1_term | opaque_2_term | opaque_3_term) ;
variant_test = (result_test) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")" | variant_test) ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
