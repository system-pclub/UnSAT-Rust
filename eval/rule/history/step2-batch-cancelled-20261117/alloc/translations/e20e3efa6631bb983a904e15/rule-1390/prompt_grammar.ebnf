memory_storage_3_term, ".", "writable" | memory_storage_3_term, ".", "initialized" | memory_storage_3_term, ".", "valid" | memory_storage_9_term, ".", "exists" | memory_storage_9_term, ".", "readable" | memory_storage_9_term, ".", "writable" | memory_storage_9_term, ".", "initialized" | memory_storage_9_term, ".", "valid" | memory_storage_1_term, ".", "exists" | memory_storage_1_term, ".", "readable" | memory_storage_1_term, ".", "writable" | memory_storage_1_term, ".", "initialized" | memory_storage_1_term, ".", "valid" | "(", memory_bool_term, ")") ;
(* MemoryInteger *)
memory_integer_term = (memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_storage_11_term, ".", "start" | memory_storage_11_term, ".", "size" | memory_storage_11_term, ".", "end" | memory_storage_11_term, ".", "align" | memory_storage_11_term, ".", "readable_size" | memory_storage_11_term, ".", "writable_size" | memory_storage_6_term, ".", "start" | memory_storage_6_term, ".", "size" | memory_storage_6_term, ".", "end" | memory_storage_6_term, ".", "align" | memory_storage_6_term, ".", "readable_size" | memory_storage_6_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | memory_region_term, ".", "start" | memory_region_term, ".", "size" | memory_region_term, ".", "end" | memory_region_term, ".", "align" | memory_region_term, ".", "readable_size" | memory_region_term, ".", "writable_size" | memory_storage_4_term, ".", "start" | memory_storage_4_term, ".", "size" | memory_storage_4_term, ".", "end" | memory_storage_4_term, ".", "align" | memory_storage_4_term, ".", "readable_size" | memory_storage_4_term, ".", "writable_size" | memory_storage_5_term, ".", "start" | memory_storage_5_term, ".", "size" | memory_storage_5_term, ".", "end" | memory_storage_5_term, ".", "align" | memory_storage_5_term, ".", "readable_size" | memory_storage_5_term, ".", "writable_size" | memory_storage_7_term, ".", "start" | memory_storage_7_term, ".", "size" | memory_storage_7_term, ".", "end" | memory_storage_7_term, ".", "align" | memory_storage_7_term, ".", "readable_size" | memory_storage_7_term, ".", "writable_size" | memory_storage_10_term, ".", "start" | memory_storage_10_term, ".", "size" | memory_storage_10_term, ".", "end" | memory_storage_10_term, ".", "align" | memory_storage_10_term, ".", "readable_size" | memory_storage_10_term, ".", "writable_size" | memory_storage_8_term, ".", "start" | memory_storage_8_term, ".", "size" | memory_storage_8_term, ".", "end" | memory_storage_8_term, ".", "align" | memory_storage_8_term, ".", "readable_size" | memory_storage_8_term, ".", "writable_size" | memory_storage_3_term, ".", "start" | memory_storage_3_term, ".", "size" | memory_storage_3_term, ".", "end" | memory_storage_3_term, ".", "align" | memory_storage_3_term, ".", "readable_size" | memory_storage_3_term, ".", "writable_size" | memory_storage_9_term, ".", "start" | memory_storage_9_term, ".", "size" | memory_storage_9_term, ".", "end" | memory_storage_9_term, ".", "align" | memory_storage_9_term, ".", "readable_size" | memory_storage_9_term, ".", "writable_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | "(", memory_integer_term, ")") ;
(* MemoryRegion<T> *)
memory_region_term = (memory_storage_2_term, ".", "pointee" | memory_storage_10_term, ".", "pointee" | memory_storage_9_term, ".", "pointee" | memory_storage_1_term, ".", "pointee" | "(", memory_region_term, ")") ;
(* MemoryStorage<*const T> *)
memory_storage_1_term = (pointer_1_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<*mut T> *)
memory_storage_2_term = (pointer_2_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<A> *)
memory_storage_3_term = (a_term, ".", "$mem" | "(", memory_storage_3_term, ")") ;
(* MemoryStorage<alloc::raw_vec::RawVec<T, A>> *)
memory_storage_4_term = (raw_vec_term, ".", "$mem" | "(", memory_storage_4_term, ")") ;
(* MemoryStorage<alloc::raw_vec::RawVecInner<A>> *)
memory_storage_5_term = (raw_vec_inner_term, ".", "$mem" | "(", memory_storage_5_term, ")") ;
(* MemoryStorage<alloc::vec::Vec<T, A>> *)
memory_storage_6_term = (vec_term, ".", "$mem" | "(", memory_storage_6_term, ")") ;
(* MemoryStorage<core::marker::PhantomData<T>> *)
memory_storage_7_term = (phantom_data_term, ".", "$mem" | "(", memory_storage_7_term, ")") ;
(* MemoryStorage<core::num::niche_types::UsizeNoHighBit> *)
memory_storage_8_term = (cap_term, ".", "$mem" | "(", memory_storage_8_term, ")") ;
(* MemoryStorage<core::ptr::non_null::NonNull<T>> *)
memory_storage_9_term = (non_null_term, ".", "$mem" | "(", memory_storage_9_term, ")") ;
(* MemoryStorage<core::ptr::unique::Unique<T>> *)
memory_storage_10_term = (unique_term, ".", "$mem" | "(", memory_storage_10_term, ")") ;
(* MemoryStorage<usize> *)
memory_storage_11_term = (usize_term, ".", "$mem" | "(", memory_storage_11_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* alloc::raw_vec::Cap; core::num::niche_types::UsizeNoHighBit *)
cap_term = (raw_vec_inner_term, ".", "cap" | "(", cap_term, ")") ;
(* alloc::raw_vec::RawVec<T, A> *)
raw_vec_term = (vec_term, ".", "buf" | "(", raw_vec_term, ")") ;
(* alloc::raw_vec::RawVecInner<A> *)
raw_vec_inner_term = (raw_vec_term, ".", "inner" | "(", raw_vec_inner_term, ")") ;
(* alloc::vec::Vec<T, A> *)
vec_term = ("$5" | "(", vec_term, ")") ;
(* core::marker::PhantomData<T> *)
phantom_data_term = (raw_vec_term, ".", "_marker" | unique_term, ".", "_marker" | "(", phantom_data_term, ")") ;
(* core::ptr::non_null::NonNull<T> *)
non_null_term = (unique_term, ".", "pointer" | "(", non_null_term, ")") ;
(* core::ptr::unique::Unique<T> *)
unique_term = (raw_vec_inner_term, ".", "ptr" | "(", unique_term, ")") ;
(* type parameter T *)
opaque_term = ("$4" | "(", opaque_term, ")") ;
(* usize *)
usize_term = ("$2" | "$3" | vec_term, ".", "len" | "(", usize_term, ")") ;
typed_term = (pointer_1_term | pointer_2_term | a_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_region_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_storage_7_term | memory_storage_8_term | memory_storage_9_term | memory_storage_10_term | memory_storage_11_term | memory_string_term | cap_term | raw_vec_term | raw_vec_inner_term | vec_term | phantom_data_term | non_null_term | unique_term | opaque_term | usize_term) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")") ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
