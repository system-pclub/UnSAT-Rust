(* Generated concrete EBNF. Every field, tuple position and enum tag is a literal. *)
(* $1 is self: Self [argument]. *)
(* $2 is ptr: * mut u8 [argument]. *)
(* $3 is layout: core::alloc::layout::Layout [argument]. *)
(* $4 is new_size: usize [argument]. *)
(* $5 is Self: type metadata [type_parameter]. *)
(* $6 is result: * mut u8 [return_value]. *)
(* Bare identifier entries are comprehension locals only; scope and element types are checked separately. *)

(* *mut u8 *)
pointer_term = ("$2" | "$6" | "(", pointer_term, ")") ;
(* MemoryAllocation *)
memory_allocation_term = (memory_storage_2_term, ".", "allocation" | memory_storage_1_term, ".", "allocation" | memory_storage_3_term, ".", "allocation" | memory_storage_6_term, ".", "allocation" | memory_region_term, ".", "allocation" | memory_storage_4_term, ".", "allocation" | memory_storage_5_term, ".", "allocation" | "(", memory_allocation_term, ")") ;
(* MemoryBool *)
memory_bool_term = (memory_storage_2_term, ".", "exists" | memory_storage_2_term, ".", "readable" | memory_storage_2_term, ".", "writable" | memory_storage_2_term, ".", "initialized" | memory_storage_2_term, ".", "valid" | memory_storage_1_term, ".", "exists" | memory_storage_1_term, ".", "readable" | memory_storage_1_term, ".", "writable" | memory_storage_1_term, ".", "initialized" | memory_storage_1_term, ".", "valid" | memory_storage_3_term, ".", "exists" | memory_storage_3_term, ".", "readable" | memory_storage_3_term, ".", "writable" | memory_storage_3_term, ".", "initialized" | memory_storage_3_term, ".", "valid" | memory_storage_6_term, ".", "exists" | memory_storage_6_term, ".", "readable" | memory_storage_6_term, ".", "writable" | memory_storage_6_term, ".", "initialized" | memory_storage_6_term, ".", "valid" | memory_allocation_term, ".", "exists" | memory_allocation_term, ".", "live" | memory_region_term, ".", "exists" | memory_region_term, ".", "readable" | memory_region_term, ".", "writable" | memory_region_term, ".", "initialized" | memory_region_term, ".", "valid" | memory_storage_4_term, ".", "exists" | memory_storage_4_term, ".", "readable" | memory_storage_4_term, ".", "writable" | memory_storage_4_term, ".", "initialized" | memory_storage_4_term, ".", "valid" | memory_storage_5_term, ".", "exists" | memory_storage_5_term, ".", "readable" | memory_storage_5_term, ".", "writable" | memory_storage_5_term, ".", "initialized" | memory_storage_5_term, ".", "valid" | "(", memory_bool_term, ")") ;
(* MemoryInteger *)
memory_integer_term = (memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | memory_storage_3_term, ".", "start" | memory_storage_3_term, ".", "size" | memory_storage_3_term, ".", "end" | memory_storage_3_term, ".", "align" | memory_storage_3_term, ".", "readable_size" | memory_storage_3_term, ".", "writable_size" | memory_storage_6_term, ".", "start" | memory_storage_6_term, ".", "size" | memory_storage_6_term, ".", "end" | memory_storage_6_term, ".", "align" | memory_storage_6_term, ".", "readable_size" | memory_storage_6_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | memory_region_term, ".", "start" | memory_region_term, ".", "size" | memory_region_term, ".", "end" | memory_region_term, ".", "align" | memory_region_term, ".", "readable_size" | memory_region_term, ".", "writable_size" | memory_storage_4_term, ".", "start" | memory_storage_4_term, ".", "size" | memory_storage_4_term, ".", "end" | memory_storage_4_term, ".", "align" | memory_storage_4_term, ".", "readable_size" | memory_storage_4_term, ".", "writable_size" | memory_storage_5_term, ".", "start" | memory_storage_5_term, ".", "size" | memory_storage_5_term, ".", "end" | memory_storage_5_term, ".", "align" | memory_storage_5_term, ".", "readable_size" | memory_storage_5_term, ".", "writable_size" | "(", memory_integer_term, ")") ;
(* MemoryRegion<u8> *)
memory_region_term = (memory_storage_1_term, ".", "pointee" | "(", memory_region_term, ")") ;
(* MemoryStorage<*mut u8> *)
memory_storage_1_term = (pointer_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<Self> *)
memory_storage_2_term = (self_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<core::alloc::layout::Layout> *)
memory_storage_3_term = (layout_term, ".", "$mem" | "(", memory_storage_3_term, ")") ;
(* MemoryStorage<core::ptr::alignment::Alignment> *)
memory_storage_4_term = (alignment_term, ".", "$mem" | "(", memory_storage_4_term, ")") ;
(* MemoryStorage<core::ptr::alignment::AlignmentEnum> *)
memory_storage_5_term = (alignment_enum_term, ".", "$mem" | "(", memory_storage_5_term, ")") ;
(* MemoryStorage<usize> *)
memory_storage_6_term = (usize_term, ".", "$mem" | "(", memory_storage_6_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* Self *)
self_term = ("$1" | "(", self_term, ")") ;
(* core::alloc::layout::Layout *)
layout_term = ("$3" | "(", layout_term, ")") ;
(* core::ptr::alignment::Alignment *)
alignment_term = (layout_term, ".", "align" | "(", alignment_term, ")") ;
(* core::ptr::alignment::AlignmentEnum *)
alignment_enum_term = (alignment_term, "[", "0", "]" | "(", alignment_enum_term, ")") ;
(* type parameter Self *)
opaque_term = ("$5" | "(", opaque_term, ")") ;
(* usize *)
usize_term = ("$4" | layout_term, ".", "size" | "(", usize_term, ")") ;
typed_term = (pointer_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_region_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_string_term | self_term | layout_term | alignment_term | alignment_enum_term | opaque_term | usize_term) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")") ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
