memory_storage_1_term: (ascii_char_term "." "$mem" | "(" memory_storage_1_term ")")
memory_storage_2_term: (u8_term "." "$mem" | "(" memory_storage_2_term ")")
ascii_char_term: ("$2" | "(" ascii_char_term ")")
ascii_char_variant: ("\"Null\"" | "'Null'" | "\"StartOfHeading\"" | "'StartOfHeading'" | "\"StartOfText\"" | "'StartOfText'" | "\"EndOfText\"" | "'EndOfText'" | "\"EndOfTransmission\"" | "'EndOfTransmission'" | "\"Enquiry\"" | "'Enquiry'" | "\"Acknowledge\"" | "'Acknowledge'" | "\"Bell\"" | "'Bell'" | "\"Backspace\"" | "'Backspace'" | "\"CharacterTabulation\"" | "'CharacterTabulation'" | "\"LineFeed\"" | "'LineFeed'" | "\"LineTabulation\"" | "'LineTabulation'" | "\"FormFeed\"" | "'FormFeed'" | "\"CarriageReturn\"" | "'CarriageReturn'" | "\"ShiftOut\"" | "'ShiftOut'" | "\"ShiftIn\"" | "'ShiftIn'" | "\"DataLinkEscape\"" | "'DataLinkEscape'" | "\"DeviceControlOne\"" | "'DeviceControlOne'" | "\"DeviceControlTwo\"" | "'DeviceControlTwo'" | "\"DeviceControlThree\"" | "'DeviceControlThree'" | "\"DeviceControlFour\"" | "'DeviceControlFour'" | "\"NegativeAcknowledge\"" | "'NegativeAcknowledge'" | "\"SynchronousIdle\"" | "'SynchronousIdle'" | "\"EndOfTransmissionBlock\"" | "'EndOfTransmissionBlock'" | "\"Cancel\"" | "'Cancel'" | "\"EndOfMedium\"" | "'EndOfMedium'" | "\"Substitute\"" | "'Substitute'" | "\"Escape\"" | "'Escape'" | "\"InformationSeparatorFour\"" | "'InformationSeparatorFour'" | "\"InformationSeparatorThree\"" | "'InformationSeparatorThree'" | "\"InformationSeparatorTwo\"" | "'InformationSeparatorTwo'" | "\"InformationSeparatorOne\"" | "'InformationSeparatorOne'" | "\"Space\"" | "'Space'" | "\"ExclamationMark\"" | "'ExclamationMark'" | "\"QuotationMark\"" | "'QuotationMark'" | "\"NumberSign\"" | "'NumberSign'" | "\"DollarSign\"" | "'DollarSign'" | "\"PercentSign\"" | "'PercentSign'" | "\"Ampersand\"" | "'Ampersand'" | "\"Apostrophe\"" | "'Apostrophe'" | "\"LeftParenthesis\"" | "'LeftParenthesis'" | "\"RightParenthesis\"" | "'RightParenthesis'" | "\"Asterisk\"" | "'Asterisk'" | "\"PlusSign\"" | "'PlusSign'" | "\"Comma\"" | "'Comma'" | "\"HyphenMinus\"" | "'HyphenMinus'" | "\"FullStop\"" | "'FullStop'" | "\"Solidus\"" | "'Solidus'" | "\"Digit0\"" | "'Digit0'" | "\"Digit1\"" | "'Digit1'" | "\"Digit2\"" | "'Digit2'" | "\"Digit3\"" | "'Digit3'" | "\"Digit4\"" | "'Digit4'" | "\"Digit5\"" | "'Digit5'" | "\"Digit6\"" | "'Digit6'" | "\"Digit7\"" | "'Digit7'" | "\"Digit8\"" | "'Digit8'" | "\"Digit9\"" | "'Digit9'" | "\"Colon\"" | "'Colon'" | "\"Semicolon\"" | "'Semicolon'" | "\"LessThanSign\"" | "'LessThanSign'" | "\"EqualsSign\"" | "'EqualsSign'" | "\"GreaterThanSign\"" | "'GreaterThanSign'" | "\"QuestionMark\"" | "'QuestionMark'" | "\"CommercialAt\"" | "'CommercialAt'" | "\"CapitalA\"" | "'CapitalA'" | "\"CapitalB\"" | "'CapitalB'" | "\"CapitalC\"" | "'CapitalC'" | "\"CapitalD\"" | "'CapitalD'" | "\"CapitalE\"" | "'CapitalE'" | "\"CapitalF\"" | "'CapitalF'" | "\"CapitalG\"" | "'CapitalG'" | "\"CapitalH\"" | "'CapitalH'" | "\"CapitalI\"" | "'CapitalI'" | "\"CapitalJ\"" | "'CapitalJ'" | "\"CapitalK\"" | "'CapitalK'" | "\"CapitalL\"" | "'CapitalL'" | "\"CapitalM\"" | "'CapitalM'" | "\"CapitalN\"" | "'CapitalN'" | "\"CapitalO\"" | "'CapitalO'" | "\"CapitalP\"" | "'CapitalP'" | "\"CapitalQ\"" | "'CapitalQ'" | "\"CapitalR\"" | "'CapitalR'" | "\"CapitalS\"" | "'CapitalS'" | "\"CapitalT\"" | "'CapitalT'" | "\"CapitalU\"" | "'CapitalU'" | "\"CapitalV\"" | "'CapitalV'" | "\"CapitalW\"" | "'CapitalW'" | "\"CapitalX\"" | "'CapitalX'" | "\"CapitalY\"" | "'CapitalY'" | "\"CapitalZ\"" | "'CapitalZ'" | "\"LeftSquareBracket\"" | "'LeftSquareBracket'" | "\"ReverseSolidus\"" | "'ReverseSolidus'" | "\"RightSquareBracket\"" | "'RightSquareBracket'" | "\"CircumflexAccent\"" | "'CircumflexAccent'" | "\"LowLine\"" | "'LowLine'" | "\"GraveAccent\"" | "'GraveAccent'" | "\"SmallA\"" | "'SmallA'" | "\"SmallB\"" | "'SmallB'" | "\"SmallC\"" | "'SmallC'" | "\"SmallD\"" | "'SmallD'" | "\"SmallE\"" | "'SmallE'" | "\"SmallF\"" | "'SmallF'" | "\"SmallG\"" | "'SmallG'" | "\"SmallH\"" | "'SmallH'" | "\"SmallI\"" | "'SmallI'" | "\"SmallJ\"" | "'SmallJ'" | "\"SmallK\"" | "'SmallK'" | "\"SmallL\"" | "'SmallL'" | "\"SmallM\"" | "'SmallM'" | "\"SmallN\"" | "'SmallN'" | "\"SmallO\"" | "'SmallO'" | "\"SmallP\"" | "'SmallP'" | "\"SmallQ\"" | "'SmallQ'" | "\"SmallR\"" | "'SmallR'" | "\"SmallS\"" | "'SmallS'" | "\"SmallT\"" | "'SmallT'" | "\"SmallU\"" | "'SmallU'" | "\"SmallV\"" | "'SmallV'" | "\"SmallW\"" | "'SmallW'" | "\"SmallX\"" | "'SmallX'" | "\"SmallY\"" | "'SmallY'" | "\"SmallZ\"" | "'SmallZ'" | "\"LeftCurlyBracket\"" | "'LeftCurlyBracket'" | "\"VerticalLine\"" | "'VerticalLine'" | "\"RightCurlyBracket\"" | "'RightCurlyBracket'" | "\"Tilde\"" | "'Tilde'" | "\"Delete\"" | "'Delete'")
ascii_char_test: "is_variant" "(" ascii_char_term "," ascii_char_variant ")"
u8_term: ("$1" | "(" u8_term ")")
typed_term: (memory_storage_1_term | memory_storage_2_term | ascii_char_term | u8_term)
variant_test: (ascii_char_test)
formula: expression
expression: disjunction ("if" disjunction "else" expression)?
disjunction: conjunction ("or" conjunction)*
conjunction: negation ("and" negation)*
negation: ("not" negation | comparison)
comparison: arithmetic (compare arithmetic)*
compare: ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in")
arithmetic: product (("+" | "-") product)*
product: unary (("*" | "//" | "%") unary)*
unary: (("+" | "-"))? primary
primary: (typed_term | integer | string | "True" | "False" | "None" | "(" expression ")" | collection | builtin)
collection: ("[" (expression ("," expression)*)? "]" | "[" expression comprehension "]")
comprehension: "for" identifier "in" disjunction ("if" disjunction)* (comprehension)?
builtin: (("all" | "any") "(" expression ")" | "len" "(" expression ")" | variant_test)
identifier: IDENTIFIER
integer: INTEGER
string: STRING
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
INTEGER: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
%import common.WS
%ignore WS
