(* Generated concrete EBNF. Every field, tuple position and enum tag is a literal. *)
(* $1 is self: core::option::Option < T > [argument]. *)
(* $2 is T: type metadata [type_parameter]. *)
(* $3 is result: T [return_value]. *)
(* Bare identifier entries are comprehension locals only; scope and element types are checked separately. *)

(* MemoryAllocation *)
memory_allocation_term = (memory_storage_3_term, ".", "allocation" | memory_storage_1_term, ".", "allocation" | memory_storage_2_term, ".", "allocation" | "(", memory_allocation_term, ")") ;
(* MemoryBool *)
memory_bool_term = (memory_storage_3_term, ".", "exists" | memory_storage_3_term, ".", "readable" | memory_storage_3_term, ".", "writable" | memory_storage_3_term, ".", "initialized" | memory_storage_3_term, ".", "valid" | memory_storage_1_term, ".", "exists" | memory_storage_1_term, ".", "readable" | memory_storage_1_term, ".", "writable" | memory_storage_1_term, ".", "initialized" | memory_storage_1_term, ".", "valid" | memory_storage_2_term, ".", "exists" | memory_storage_2_term, ".", "readable" | memory_storage_2_term, ".", "writable" | memory_storage_2_term, ".", "initialized" | memory_storage_2_term, ".", "valid" | memory_allocation_term, ".", "exists" | memory_allocation_term, ".", "live" | "(", memory_bool_term, ")") ;
(* MemoryInteger *)
memory_integer_term = (memory_storage_3_term, ".", "start" | memory_storage_3_term, ".", "size" | memory_storage_3_term, ".", "end" | memory_storage_3_term, ".", "align" | memory_storage_3_term, ".", "readable_size" | memory_storage_3_term, ".", "writable_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | "(", memory_integer_term, ")") ;
(* MemoryStorage<T> *)
memory_storage_1_term = (t_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<core::option::Option::Some<T>> *)
memory_storage_2_term = (some_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<core::option::Option<T>> *)
memory_storage_3_term = (option_term, ".", "$mem" | "(", memory_storage_3_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* T *)
t_term = ("$3" | some_term, "[", "0", "]" | "(", t_term, ")") ;
(* core::option::Option::Some<T> *)
some_term = (option_term, ".", "Some" | "(", some_term, ")") ;
(* core::option::Option<T> *)
option_term = ("$1" | "(", option_term, ")") ;
option_variant = ("\"None\"" | "'None'" | "\"Some\"" | "'Some'") ;
option_test = "is_variant", "(", option_term, ",", option_variant, ")" ;
(* type parameter T *)
opaque_term = ("$2" | "(", opaque_term, ")") ;
typed_term = (memory_allocation_term | memory_bool_term | memory_integer_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_string_term | t_term | some_term | option_term | opaque_term) ;
variant_test = (option_test) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")" | variant_test) ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
