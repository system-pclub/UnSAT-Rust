(* Generated concrete EBNF. Every field, tuple position and enum tag is a literal. *)
(* $1 is key: Key [argument]. *)
(* $2 is ptr: * mut std::sys::thread_local::os::Value < T > [argument]. *)
(* $3 is i: core::option::Option < & mut core::option::Option < T > > [argument]. *)
(* $4 is f: impl FnOnce () -> T [argument]. *)
(* $5 is T: type metadata [type_parameter]. *)
(* $6 is result: * const T [return_value]. *)
(* Bare identifier entries are comprehension locals only; scope and element types are checked separately. *)

(* *const T *)
pointer_1_term = ("$6" | "(", pointer_1_term, ")") ;
(* *mut std::sys::thread_local::os::Value<T> *)
pointer_2_term = ("$2" | "(", pointer_2_term, ")") ;
(* Key *)
key_term = ("$1" | "(", key_term, ")") ;
(* MemoryAllocation *)
