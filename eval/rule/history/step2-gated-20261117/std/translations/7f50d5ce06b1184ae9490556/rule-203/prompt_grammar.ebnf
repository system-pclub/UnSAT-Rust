(* MemoryBool *)
memory_bool_term = (memory_storage_3_term, ".", "exists" | memory_storage_3_term, ".", "readable" | memory_storage_3_term, ".", "writable" | memory_storage_3_term, ".", "initialized" | memory_storage_3_term, ".", "valid" | memory_storage_2_term, ".", "exists" | memory_storage_2_term, ".", "readable" | memory_storage_2_term, ".", "writable" | memory_storage_2_term, ".", "initialized" | memory_storage_2_term, ".", "valid" | memory_storage_6_term, ".", "exists" | memory_storage_6_term, ".", "readable" | memory_storage_6_term, ".", "writable" | memory_storage_6_term, ".", "initialized" | memory_storage_6_term, ".", "valid" | memory_storage_7_term, ".", "exists" | memory_storage_7_term, ".", "readable" | memory_storage_7_term, ".", "writable" | memory_storage_7_term, ".", "initialized" | memory_storage_7_term, ".", "valid" | memory_storage_1_term, ".", "exists" | memory_storage_1_term, ".", "readable" | memory_storage_1_term, ".", "writable" | memory_storage_1_term, ".", "initialized" | memory_storage_1_term, ".", "valid" | memory_allocation_term, ".", "exists" | memory_allocation_term, ".", "live" | memory_region_2_term, ".", "exists" | memory_region_2_term, ".", "readable" | memory_region_2_term, ".", "writable" | memory_region_2_term, ".", "initialized" | memory_region_2_term, ".", "valid" | memory_storage_5_term, ".", "exists" | memory_storage_5_term, ".", "readable" | memory_storage_5_term, ".", "writable" | memory_storage_5_term, ".", "initialized" | memory_storage_5_term, ".", "valid" | memory_region_1_term, ".", "exists" | memory_region_1_term, ".", "readable" | memory_region_1_term, ".", "writable" | memory_region_1_term, ".", "initialized" | memory_region_1_term, ".", "valid" | memory_storage_4_term, ".", "exists" | memory_storage_4_term, ".", "readable" | memory_storage_4_term, ".", "writable" | memory_storage_4_term, ".", "initialized" | memory_storage_4_term, ".", "valid" | "(", memory_bool_term, ")") ;
(* MemoryInteger *)
memory_integer_term = (memory_storage_3_term, ".", "start" | memory_storage_3_term, ".", "size" | memory_storage_3_term, ".", "end" | memory_storage_3_term, ".", "align" | memory_storage_3_term, ".", "readable_size" | memory_storage_3_term, ".", "writable_size" | memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_storage_6_term, ".", "start" | memory_storage_6_term, ".", "size" | memory_storage_6_term, ".", "end" | memory_storage_6_term, ".", "align" | memory_storage_6_term, ".", "readable_size" | memory_storage_6_term, ".", "writable_size" | memory_storage_7_term, ".", "start" | memory_storage_7_term, ".", "size" | memory_storage_7_term, ".", "end" | memory_storage_7_term, ".", "align" | memory_storage_7_term, ".", "readable_size" | memory_storage_7_term, ".", "writable_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | memory_region_2_term, ".", "start" | memory_region_2_term, ".", "size" | memory_region_2_term, ".", "end" | memory_region_2_term, ".", "align" | memory_region_2_term, ".", "readable_size" | memory_region_2_term, ".", "writable_size" | memory_storage_5_term, ".", "start" | memory_storage_5_term, ".", "size" | memory_storage_5_term, ".", "end" | memory_storage_5_term, ".", "align" | memory_storage_5_term, ".", "readable_size" | memory_storage_5_term, ".", "writable_size" | memory_region_1_term, ".", "start" | memory_region_1_term, ".", "size" | memory_region_1_term, ".", "end" | memory_region_1_term, ".", "align" | memory_region_1_term, ".", "readable_size" | memory_region_1_term, ".", "writable_size" | memory_storage_4_term, ".", "start" | memory_storage_4_term, ".", "size" | memory_storage_4_term, ".", "end" | memory_storage_4_term, ".", "align" | memory_storage_4_term, ".", "readable_size" | memory_storage_4_term, ".", "writable_size" | "(", memory_integer_term, ")") ;
(* MemoryRegion<T> *)
memory_region_1_term = (memory_storage_1_term, ".", "pointee" | "(", memory_region_1_term, ")") ;
(* MemoryRegion<std::sys::thread_local::os::Value<T>> *)
memory_region_2_term = (memory_storage_2_term, ".", "pointee" | "(", memory_region_2_term, ")") ;
(* MemoryStorage<*const T> *)
memory_storage_1_term = (pointer_1_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<*mut std::sys::thread_local::os::Value<T>> *)
memory_storage_2_term = (pointer_2_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<Key> *)
memory_storage_3_term = (key_term, ".", "$mem" | "(", memory_storage_3_term, ")") ;
(* MemoryStorage<T> *)
memory_storage_4_term = (t_term, ".", "$mem" | "(", memory_storage_4_term, ")") ;
(* MemoryStorage<core::option::Option::Some<T>> *)
memory_storage_5_term = (some_term, ".", "$mem" | "(", memory_storage_5_term, ")") ;
(* MemoryStorage<core::option::Option<T>> *)
memory_storage_6_term = (option_term, ".", "$mem" | "(", memory_storage_6_term, ")") ;
(* MemoryStorage<impl FnOnce () -> T> *)
memory_storage_7_term = (opaque_1_term, ".", "$mem" | "(", memory_storage_7_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* T *)
t_term = (some_term, "[", "0", "]" | "(", t_term, ")") ;
(* core::option::Option::Some<T> *)
some_term = (option_term, ".", "Some" | "(", some_term, ")") ;
(* core::option::Option<T> *)
option_term = ("$3" | "(", option_term, ")") ;
option_variant = ("\"None\"" | "'None'" | "\"Some\"" | "'Some'") ;
option_test = "is_variant", "(", option_term, ",", option_variant, ")" ;
(* impl FnOnce () -> T *)
opaque_1_term = ("$4" | "(", opaque_1_term, ")") ;
(* type parameter T *)
opaque_2_term = ("$5" | "(", opaque_2_term, ")") ;
typed_term = (pointer_1_term | pointer_2_term | key_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_region_1_term | memory_region_2_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_storage_7_term | memory_string_term | t_term | some_term | option_term | opaque_1_term | opaque_2_term) ;
variant_test = (option_test) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")" | variant_test) ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
