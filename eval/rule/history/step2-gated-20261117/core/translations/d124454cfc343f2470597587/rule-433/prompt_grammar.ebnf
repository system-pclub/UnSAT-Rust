(* Generated concrete EBNF. Every field, tuple position and enum tag is a literal. *)
(* $1 is self: [MaybeUninit < T >] [argument]. *)
(* $2 is T: type metadata [type_parameter]. *)
(* Bare identifier entries are comprehension locals only; scope and element types are checked separately. *)

(* MaybeUninit *)
maybe_uninit_term = (identifier | sequence_term, "[", index, "]" | "(", maybe_uninit_term, ")") ;
(* MemoryAllocation *)
memory_allocation_term = (memory_storage_2_term, ".", "allocation" | memory_storage_1_term, ".", "allocation" | "(", memory_allocation_term, ")") ;
(* MemoryBool *)
memory_bool_term = (memory_storage_2_term, ".", "exists" | memory_storage_2_term, ".", "readable" | memory_storage_2_term, ".", "writable" | memory_storage_2_term, ".", "initialized" | memory_storage_2_term, ".", "valid" | memory_storage_1_term, ".", "exists" | memory_storage_1_term, ".", "readable" | memory_storage_1_term, ".", "writable" | memory_storage_1_term, ".", "initialized" | memory_storage_1_term, ".", "valid" | memory_allocation_term, ".", "exists" | memory_allocation_term, ".", "live" | "(", memory_bool_term, ")") ;
(* MemoryInteger *)
memory_integer_term = (memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | "(", memory_integer_term, ")") ;
(* MemoryStorage<MaybeUninit> *)
memory_storage_1_term = (maybe_uninit_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<[MaybeUninit]> *)
memory_storage_2_term = (sequence_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* [MaybeUninit] *)
sequence_term = ("$1" | "(", sequence_term, ")") ;
(* type parameter T *)
opaque_term = ("$2" | "(", opaque_term, ")") ;
typed_term = (maybe_uninit_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_storage_1_term | memory_storage_2_term | memory_string_term | sequence_term | opaque_term) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")") ;
index = index_product, { ("+" | "-"), index_product } ;
index_product = index_unary, { ("*" | "//" | "%"), index_unary } ;
index_unary = [ ("+" | "-") ], index_primary ;
index_primary = (integer | "(", index, ")" | "len", "(", expression, ")" | memory_integer_term) ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
