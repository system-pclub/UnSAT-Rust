(* MemoryInteger *)
memory_integer_term = (memory_storage_3_term, ".", "start" | memory_storage_3_term, ".", "size" | memory_storage_3_term, ".", "end" | memory_storage_3_term, ".", "align" | memory_storage_3_term, ".", "readable_size" | memory_storage_3_term, ".", "writable_size" | memory_storage_5_term, ".", "start" | memory_storage_5_term, ".", "size" | memory_storage_5_term, ".", "end" | memory_storage_5_term, ".", "align" | memory_storage_5_term, ".", "readable_size" | memory_storage_5_term, ".", "writable_size" | memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_storage_4_term, ".", "start" | memory_storage_4_term, ".", "size" | memory_storage_4_term, ".", "end" | memory_storage_4_term, ".", "align" | memory_storage_4_term, ".", "readable_size" | memory_storage_4_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | "(", memory_integer_term, ")") ;
(* MemoryStorage<T> *)
memory_storage_1_term = (t_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<[T]> *)
memory_storage_2_term = (sequence_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<alloc::collections::binary_heap::Hole<T>> *)
memory_storage_3_term = (hole_term, ".", "$mem" | "(", memory_storage_3_term, ")") ;
(* MemoryStorage<core::mem::manually_drop::ManuallyDrop<T>> *)
memory_storage_4_term = (manually_drop_term, ".", "$mem" | "(", memory_storage_4_term, ")") ;
(* MemoryStorage<usize> *)
memory_storage_5_term = (usize_term, ".", "$mem" | "(", memory_storage_5_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* T *)
t_term = (identifier | sequence_term, "[", index, "]" | manually_drop_term, ".", "value" | "(", t_term, ")") ;
(* [T] *)
sequence_term = (hole_term, ".", "data" | "(", sequence_term, ")") ;
(* alloc::collections::binary_heap::Hole<T> *)
hole_term = ("$1" | "(", hole_term, ")") ;
(* core::mem::manually_drop::ManuallyDrop<T> *)
manually_drop_term = (hole_term, ".", "elt" | "(", manually_drop_term, ")") ;
(* lifetime parameter 'a *)
opaque_1_term = ("$3" | "(", opaque_1_term, ")") ;
(* type parameter T *)
opaque_2_term = ("$4" | "(", opaque_2_term, ")") ;
(* usize *)
usize_term = ("$2" | hole_term, ".", "pos" | "(", usize_term, ")") ;
typed_term = (memory_allocation_term | memory_bool_term | memory_integer_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_string_term | t_term | sequence_term | hole_term | manually_drop_term | opaque_1_term | opaque_2_term | usize_term) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")") ;
index = index_product, { ("+" | "-"), index_product } ;
index_product = index_unary, { ("*" | "//" | "%"), index_unary } ;
index_unary = [ ("+" | "-") ], index_primary ;
index_primary = (integer | "(", index, ")" | "len", "(", expression, ")" | memory_integer_term | usize_term) ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
