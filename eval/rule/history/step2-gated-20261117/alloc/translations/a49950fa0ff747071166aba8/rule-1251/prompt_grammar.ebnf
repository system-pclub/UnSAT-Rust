(* MemoryStorage<alloc::boxed::Box<T, A>> *)
memory_storage_4_term = (box_term, ".", "$mem" | "(", memory_storage_4_term, ")") ;
(* MemoryStorage<alloc::ffi::c_str::CString> *)
memory_storage_5_term = (cstring_term, ".", "$mem" | "(", memory_storage_5_term, ")") ;
(* MemoryStorage<core::marker::PhantomData<T>> *)
