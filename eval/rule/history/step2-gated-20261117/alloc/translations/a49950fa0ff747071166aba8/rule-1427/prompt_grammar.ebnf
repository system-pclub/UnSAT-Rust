(* Generated concrete EBNF. Every field, tuple position and enum tag is a literal. *)
(* $1 is self: alloc::vec::drain::Drain < '_ , T , A > [argument]. *)
(* $2 is replace_with: & mut I [argument]. *)
(* $3 is T: type metadata [type_parameter]. *)
(* $4 is A: type metadata [type_parameter]. *)
(* $5 is I: type metadata [type_parameter]. *)
(* $6 is result: bool [return_value]. *)
(* Bare identifier entries are comprehension locals only; scope and element types are checked separately. *)

(* *const T *)
pointer_term = (iter_term, ".", "end_or_len" | non_null_term, ".", "pointer" | "(", pointer_term, ")") ;
(* I *)
i_term = ("$2" | "(", i_term, ")") ;
(* MemoryAllocation *)
memory_allocation_term = (memory_storage_3_term, ".", "allocation" | memory_storage_2_term, ".", "allocation" | memory_storage_4_term, ".", "allocation" | memory_storage_8_term, ".", "allocation" | memory_storage_7_term, ".", "allocation" | memory_storage_6_term, ".", "allocation" | memory_storage_1_term, ".", "allocation" | memory_storage_5_term, ".", "allocation" | memory_region_term, ".", "allocation" | "(", memory_allocation_term, ")") ;
(* MemoryBool *)
memory_bool_term = (memory_storage_3_term, ".", "exists" | memory_storage_3_term, ".", "readable" | memory_storage_3_term, ".", "writable" | memory_storage_3_term, ".", "initialized" | memory_storage_3_term, ".", "valid" | memory_storage_2_term, ".", "exists" | memory_storage_2_term, ".", "readable" | memory_storage_2_term, ".", "writable" | memory_storage_2_term, ".", "initialized" | memory_storage_2_term, ".", "valid" | memory_storage_4_term, ".", "exists" | memory_storage_4_term, ".", "readable" | memory_storage_4_term, ".", "writable" | memory_storage_4_term, ".", "initialized" | memory_storage_4_term, ".", "valid" | memory_storage_8_term, ".", "exists" | memory_storage_8_term, ".", "readable" | memory_storage_8_term, ".", "writable" | memory_storage_8_term, ".", "initialized" | memory_storage_8_term, ".", "valid" | memory_storage_7_term, ".", "exists" | memory_storage_7_term, ".", "readable" | memory_storage_7_term, ".", "writable" | memory_storage_7_term, ".", "initialized" | memory_storage_7_term, ".", "valid" | memory_storage_6_term, ".", "exists" | memory_storage_6_term, ".", "readable" | memory_storage_6_term, ".", "writable" | memory_storage_6_term, ".", "initialized" | memory_storage_6_term, ".", "valid" | memory_allocation_term, ".", "exists" | memory_allocation_term, ".", "live" | memory_storage_1_term, ".", "exists" | memory_storage_1_term, ".", "readable" | memory_storage_1_term, ".", "writable" | memory_storage_1_term, ".", "initialized" | memory_storage_1_term, ".", "valid" | memory_storage_5_term, ".", "exists" | memory_storage_5_term, ".", "readable" | memory_storage_5_term, ".", "writable" | memory_storage_5_term, ".", "initialized" | memory_storage_5_term, ".", "valid" | memory_region_term, ".", "exists" | memory_region_term, ".", "readable" | memory_region_term, ".", "writable" | memory_region_term, ".", "initialized" | memory_region_term, ".", "valid" | "(", memory_bool_term, ")") ;
(* MemoryInteger *)
memory_integer_term = (memory_storage_3_term, ".", "start" | memory_storage_3_term, ".", "size" | memory_storage_3_term, ".", "end" | memory_storage_3_term, ".", "align" | memory_storage_3_term, ".", "readable_size" | memory_storage_3_term, ".", "writable_size" | memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_storage_4_term, ".", "start" | memory_storage_4_term, ".", "size" | memory_storage_4_term, ".", "end" | memory_storage_4_term, ".", "align" | memory_storage_4_term, ".", "readable_size" | memory_storage_4_term, ".", "writable_size" | memory_storage_8_term, ".", "start" | memory_storage_8_term, ".", "size" | memory_storage_8_term, ".", "end" | memory_storage_8_term, ".", "align" | memory_storage_8_term, ".", "readable_size" | memory_storage_8_term, ".", "writable_size" | memory_storage_7_term, ".", "start" | memory_storage_7_term, ".", "size" | memory_storage_7_term, ".", "end" | memory_storage_7_term, ".", "align" | memory_storage_7_term, ".", "readable_size" | memory_storage_7_term, ".", "writable_size" | memory_storage_6_term, ".", "start" | memory_storage_6_term, ".", "size" | memory_storage_6_term, ".", "end" | memory_storage_6_term, ".", "align" | memory_storage_6_term, ".", "readable_size" | memory_storage_6_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | memory_storage_5_term, ".", "start" | memory_storage_5_term, ".", "size" | memory_storage_5_term, ".", "end" | memory_storage_5_term, ".", "align" | memory_storage_5_term, ".", "readable_size" | memory_storage_5_term, ".", "writable_size" | memory_region_term, ".", "start" | memory_region_term, ".", "size" | memory_region_term, ".", "end" | memory_region_term, ".", "align" | memory_region_term, ".", "readable_size" | memory_region_term, ".", "writable_size" | "(", memory_integer_term, ")") ;
(* MemoryRegion<T> *)
memory_region_term = (memory_storage_6_term, ".", "pointee" | memory_storage_1_term, ".", "pointee" | "(", memory_region_term, ")") ;
(* MemoryStorage<*const T> *)
memory_storage_1_term = (pointer_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<I> *)
memory_storage_2_term = (i_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<alloc::vec::drain::Drain<T, A>> *)
memory_storage_3_term = (drain_term, ".", "$mem" | "(", memory_storage_3_term, ")") ;
(* MemoryStorage<bool> *)
memory_storage_4_term = (bool_term, ".", "$mem" | "(", memory_storage_4_term, ")") ;
(* MemoryStorage<core::marker::PhantomData<T>> *)
memory_storage_5_term = (phantom_data_term, ".", "$mem" | "(", memory_storage_5_term, ")") ;
(* MemoryStorage<core::ptr::non_null::NonNull<T>> *)
memory_storage_6_term = (non_null_term, ".", "$mem" | "(", memory_storage_6_term, ")") ;
(* MemoryStorage<core::slice::iter::Iter<T>> *)
memory_storage_7_term = (iter_term, ".", "$mem" | "(", memory_storage_7_term, ")") ;
(* MemoryStorage<usize> *)
memory_storage_8_term = (usize_term, ".", "$mem" | "(", memory_storage_8_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* alloc::vec::drain::Drain<T, A> *)
drain_term = ("$1" | "(", drain_term, ")") ;
(* bool *)
bool_term = ("$6" | "(", bool_term, ")") ;
(* core::marker::PhantomData<T> *)
phantom_data_term = (iter_term, ".", "_marker" | "(", phantom_data_term, ")") ;
(* core::ptr::non_null::NonNull<T> *)
non_null_term = (drain_term, ".", "vec" | iter_term, ".", "ptr" | "(", non_null_term, ")") ;
(* core::slice::iter::Iter<T> *)
iter_term = (drain_term, ".", "iter" | "(", iter_term, ")") ;
(* type parameter A *)
opaque_1_term = ("$4" | "(", opaque_1_term, ")") ;
(* type parameter I *)
opaque_2_term = ("$5" | "(", opaque_2_term, ")") ;
(* type parameter T *)
opaque_3_term = ("$3" | "(", opaque_3_term, ")") ;
(* usize *)
usize_term = (drain_term, ".", "tail_start" | drain_term, ".", "tail_len" | "(", usize_term, ")") ;
typed_term = (pointer_term | i_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_region_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_storage_7_term | memory_storage_8_term | memory_string_term | drain_term | bool_term | phantom_data_term | non_null_term | iter_term | opaque_1_term | opaque_2_term | opaque_3_term | usize_term) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")") ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
