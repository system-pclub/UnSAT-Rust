(* Generated concrete EBNF. Every field, tuple position and enum tag is a literal. *)
(* $1 is ap: & mut VaListImpl < '_ > [argument]. *)
(* Bare identifier entries are comprehension locals only; scope and element types are checked separately. *)

(* MemoryAllocation *)
memory_allocation_term = (memory_storage_term, ".", "allocation" | "(", memory_allocation_term, ")") ;
(* MemoryBool *)
memory_bool_term = (memory_storage_term, ".", "exists" | memory_storage_term, ".", "readable" | memory_storage_term, ".", "writable" | memory_storage_term, ".", "initialized" | memory_storage_term, ".", "valid" | memory_allocation_term, ".", "exists" | memory_allocation_term, ".", "live" | "(", memory_bool_term, ")") ;
(* MemoryInteger *)
memory_integer_term = (memory_storage_term, ".", "start" | memory_storage_term, ".", "size" | memory_storage_term, ".", "end" | memory_storage_term, ".", "align" | memory_storage_term, ".", "readable_size" | memory_storage_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | "(", memory_integer_term, ")") ;
(* MemoryStorage<VaListImpl> *)
memory_storage_term = (va_list_impl_term, ".", "$mem" | "(", memory_storage_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* VaListImpl *)
va_list_impl_term = ("$1" | "(", va_list_impl_term, ")") ;
typed_term = (memory_allocation_term | memory_bool_term | memory_integer_term | memory_storage_term | memory_string_term | va_list_impl_term) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")") ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
