pointer_term: ("$2" | "(" pointer_term ")")
f_term: ("$3" | "(" f_term ")")
memory_storage_1_term: (pointer_term "." "$mem" | "(" memory_storage_1_term ")")
memory_storage_2_term: (f_term "." "$mem" | "(" memory_storage_2_term ")")
memory_storage_3_term: (sequence_term "." "$mem" | "(" memory_storage_3_term ")")
t_term: (sequence_term "[" index "]" | "(" t_term ")")
sequence_term: ("$1" | "(" sequence_term ")")
opaque_1_term: ("$5" | "(" opaque_1_term ")")
opaque_2_term: ("$4" | "(" opaque_2_term ")")
typed_term: (pointer_term | f_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | t_term | sequence_term | opaque_1_term | opaque_2_term)
formula: expression
expression: disjunction ("if" disjunction "else" expression)?
disjunction: conjunction ("or" conjunction)*
conjunction: negation ("and" negation)*
negation: ("not" negation | comparison)
comparison: arithmetic (compare arithmetic)*
compare: ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in")
arithmetic: product (("+" | "-") product)*
product: unary (("*" | "//" | "%") unary)*
unary: (("+" | "-"))? primary
primary: (typed_term | integer | string | "True" | "False" | "None" | "(" expression ")" | collection | builtin)
collection: ("[" (expression ("," expression)*)? "]" | "[" expression comprehension "]")
comprehension: "for" identifier "in" disjunction ("if" disjunction)* (comprehension)?
builtin: (("all" | "any") "(" expression ")" | "len" "(" expression ")")
index: index_product (("+" | "-") index_product)*
index_product: index_unary (("*" | "//" | "%") index_unary)*
index_unary: (("+" | "-"))? index_primary
index_primary: (integer | "(" index ")" | "len" "(" expression ")")
identifier: IDENTIFIER
integer: INTEGER
string: STRING
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
INTEGER: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
%import common.WS
%ignore WS
