(* Generated concrete EBNF. Every field, tuple position and enum tag is a literal. *)
(* $1 is buffer: [MaybeUninit < T > ; N] [argument]. *)
(* $2 is initialized: core::ops::range::Range < usize > [argument]. *)
(* $3 is T: type metadata [type_parameter]. *)
(* $4 is N: usize [const_parameter]. *)
(* $5 is result: Self [return_value]. *)
(* Bare identifier entries are comprehension locals only; scope and element types are checked separately. *)

(* Idx *)
idx_term = (range_term, ".", "start" | range_term, ".", "end" | "(", idx_term, ")") ;
(* MaybeUninit *)
maybe_uninit_1_term = (identifier | sequence_1_term, "[", index, "]" | "(", maybe_uninit_1_term, ")") ;
(* MemoryAllocation *)
