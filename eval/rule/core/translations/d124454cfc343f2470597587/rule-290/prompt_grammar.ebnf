(* MemoryInteger *)
memory_integer_term = (memory_storage_3_term, ".", "start" | memory_storage_3_term, ".", "size" | memory_storage_3_term, ".", "end" | memory_storage_3_term, ".", "align" | memory_storage_3_term, ".", "readable_size" | memory_storage_3_term, ".", "writable_size" | memory_storage_7_term, ".", "start" | memory_storage_7_term, ".", "size" | memory_storage_7_term, ".", "end" | memory_storage_7_term, ".", "align" | memory_storage_7_term, ".", "readable_size" | memory_storage_7_term, ".", "writable_size" | memory_storage_9_term, ".", "start" | memory_storage_9_term, ".", "size" | memory_storage_9_term, ".", "end" | memory_storage_9_term, ".", "align" | memory_storage_9_term, ".", "readable_size" | memory_storage_9_term, ".", "writable_size" | memory_storage_5_term, ".", "start" | memory_storage_5_term, ".", "size" | memory_storage_5_term, ".", "end" | memory_storage_5_term, ".", "align" | memory_storage_5_term, ".", "readable_size" | memory_storage_5_term, ".", "writable_size" | memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | memory_storage_4_term, ".", "start" | memory_storage_4_term, ".", "size" | memory_storage_4_term, ".", "end" | memory_storage_4_term, ".", "align" | memory_storage_4_term, ".", "readable_size" | memory_storage_4_term, ".", "writable_size" | memory_storage_6_term, ".", "start" | memory_storage_6_term, ".", "size" | memory_storage_6_term, ".", "end" | memory_storage_6_term, ".", "align" | memory_storage_6_term, ".", "readable_size" | memory_storage_6_term, ".", "writable_size" | memory_storage_8_term, ".", "start" | memory_storage_8_term, ".", "size" | memory_storage_8_term, ".", "end" | memory_storage_8_term, ".", "align" | memory_storage_8_term, ".", "readable_size" | memory_storage_8_term, ".", "writable_size" | "(", memory_integer_term, ")") ;
(* MemoryStorage<Idx> *)
memory_storage_1_term = (idx_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<MaybeUninit> *)
memory_storage_2_term = (maybe_uninit_1_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<[MaybeUninit; N]> *)
memory_storage_3_term = (sequence_1_term, ".", "$mem" | "(", memory_storage_3_term, ")") ;
(* MemoryStorage<[mem::MaybeUninit; N]> *)
memory_storage_4_term = (sequence_2_term, ".", "$mem" | "(", memory_storage_4_term, ")") ;
(* MemoryStorage<core::array::iter::IntoIter<T, N>> *)
memory_storage_5_term = (into_iter_term, ".", "$mem" | "(", memory_storage_5_term, ")") ;
(* MemoryStorage<core::ops::index_range::IndexRange> *)
memory_storage_6_term = (index_range_term, ".", "$mem" | "(", memory_storage_6_term, ")") ;
(* MemoryStorage<core::ops::range::Range<Idx>> *)
memory_storage_7_term = (range_term, ".", "$mem" | "(", memory_storage_7_term, ")") ;
(* MemoryStorage<mem::MaybeUninit> *)
memory_storage_8_term = (maybe_uninit_2_term, ".", "$mem" | "(", memory_storage_8_term, ")") ;
(* MemoryStorage<usize> *)
memory_storage_9_term = (usize_term, ".", "$mem" | "(", memory_storage_9_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* [MaybeUninit; N] *)
sequence_1_term = ("$1" | "(", sequence_1_term, ")") ;
(* [mem::MaybeUninit; N] *)
sequence_2_term = (into_iter_term, ".", "data" | "(", sequence_2_term, ")") ;
(* core::array::iter::IntoIter<T, N> *)
into_iter_term = ("$5" | "(", into_iter_term, ")") ;
(* core::ops::index_range::IndexRange *)
index_range_term = (into_iter_term, ".", "alive" | "(", index_range_term, ")") ;
(* core::ops::range::Range<Idx> *)
range_term = ("$2" | "(", range_term, ")") ;
(* mem::MaybeUninit *)
maybe_uninit_2_term = (identifier | sequence_2_term, "[", index, "]" | "(", maybe_uninit_2_term, ")") ;
(* type parameter T *)
opaque_term = ("$3" | "(", opaque_term, ")") ;
(* usize *)
usize_term = ("$4" | index_range_term, ".", "start" | index_range_term, ".", "end" | "(", usize_term, ")") ;
typed_term = (idx_term | maybe_uninit_1_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_storage_7_term | memory_storage_8_term | memory_storage_9_term | memory_string_term | sequence_1_term | sequence_2_term | into_iter_term | index_range_term | range_term | maybe_uninit_2_term | opaque_term | usize_term) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")") ;
index = index_product, { ("+" | "-"), index_product } ;
index_product = index_unary, { ("*" | "//" | "%"), index_unary } ;
index_unary = [ ("+" | "-") ], index_primary ;
index_primary = (integer | "(", index, ")" | "len", "(", expression, ")" | memory_integer_term | usize_term) ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
