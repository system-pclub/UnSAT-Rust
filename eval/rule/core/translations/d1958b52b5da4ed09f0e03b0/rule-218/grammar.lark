pointer_term: ("$4" | "(" pointer_term ")")
memory_allocation_term: (memory_storage_2_term "." "allocation" | memory_storage_3_term "." "allocation" | memory_storage_1_term "." "allocation" | "(" memory_allocation_term ")")
memory_bool_term: (memory_storage_2_term "." "exists" | memory_storage_2_term "." "readable" | memory_storage_2_term "." "writable" | memory_storage_2_term "." "initialized" | memory_storage_2_term "." "valid" | memory_storage_3_term "." "exists" | memory_storage_3_term "." "readable" | memory_storage_3_term "." "writable" | memory_storage_3_term "." "initialized" | memory_storage_3_term "." "valid" | memory_storage_1_term "." "exists" | memory_storage_1_term "." "readable" | memory_storage_1_term "." "writable" | memory_storage_1_term "." "initialized" | memory_storage_1_term "." "valid" | "(" memory_bool_term ")")
memory_integer_term: (memory_storage_2_term "." "start" | memory_storage_2_term "." "size" | memory_storage_2_term "." "end" | memory_storage_2_term "." "align" | memory_storage_2_term "." "readable_size" | memory_storage_2_term "." "writable_size" | memory_storage_3_term "." "start" | memory_storage_3_term "." "size" | memory_storage_3_term "." "end" | memory_storage_3_term "." "align" | memory_storage_3_term "." "readable_size" | memory_storage_3_term "." "writable_size" | memory_storage_1_term "." "start" | memory_storage_1_term "." "size" | memory_storage_1_term "." "end" | memory_storage_1_term "." "align" | memory_storage_1_term "." "readable_size" | memory_storage_1_term "." "writable_size" | "(" memory_integer_term ")")
memory_region_term: (memory_storage_1_term "." "pointee" | "(" memory_region_term ")")
memory_storage_1_term: (pointer_term "." "$mem" | "(" memory_storage_1_term ")")
memory_storage_2_term: (self_term "." "$mem" | "(" memory_storage_2_term ")")
memory_storage_3_term: (layout_term "." "$mem" | "(" memory_storage_3_term ")")
memory_storage_4_term: (alignment_term "." "$mem" | "(" memory_storage_4_term ")")
memory_storage_5_term: (usize_term "." "$mem" | "(" memory_storage_5_term ")")
self_term: ("$1" | "(" self_term ")")
layout_term: ("$2" | "(" layout_term ")")
alignment_term: (layout_term "." "align" | "(" alignment_term ")")
alignment_enum_term: (alignment_term "[" "0" "]" | "(" alignment_enum_term ")")
opaque_term: ("$3" | "(" opaque_term ")")
usize_term: (layout_term "." "size" | "(" usize_term ")")
typed_term: (pointer_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_region_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | self_term | layout_term | alignment_term | alignment_enum_term | opaque_term | usize_term)
formula: expression
expression: disjunction ("if" disjunction "else" expression)?
disjunction: conjunction ("or" conjunction)*
conjunction: negation ("and" negation)*
negation: ("not" negation | comparison)
comparison: arithmetic (compare arithmetic)*
compare: ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in")
arithmetic: product (("+" | "-") product)*
product: unary (("*" | "//" | "%") unary)*
unary: (("+" | "-"))? primary
primary: (typed_term | integer | string | "True" | "False" | "None" | "(" expression ")" | collection | builtin)
collection: ("[" (expression ("," expression)*)? "]" | "[" expression comprehension "]")
comprehension: "for" identifier "in" disjunction ("if" disjunction)* (comprehension)?
builtin: (("all" | "any") "(" expression ")" | "len" "(" expression ")")
identifier: IDENTIFIER
integer: INTEGER
string: STRING
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
INTEGER: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
%import common.WS
%ignore WS
