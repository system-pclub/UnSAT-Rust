pointer_term: (non_null_term "." "pointer" | "(" pointer_term ")")
memory_storage_1_term: (self_term "." "$mem" | "(" memory_storage_1_term ")")
memory_storage_2_term: (layout_term "." "$mem" | "(" memory_storage_2_term ")")
memory_storage_3_term: (non_null_term "." "$mem" | "(" memory_storage_3_term ")")
memory_storage_4_term: (result_term "." "$mem" | "(" memory_storage_4_term ")")
self_term: ("$1" | "(" self_term ")")
layout_term: ("$3" | "$4" | "(" layout_term ")")
alignment_term: (layout_term "." "align" | "(" alignment_term ")")
non_null_term: ("$2" | "(" non_null_term ")")
err_term: (result_term "." "Err" | "(" err_term ")")
ok_term: (result_term "." "Ok" | "(" ok_term ")")
result_term: ("$6" | "(" result_term ")")
result_variant: ("\"Ok\"" | "'Ok'" | "\"Err\"" | "'Err'")
result_test: "is_variant" "(" result_term "," result_variant ")"
opaque_term: ("$5" | "(" opaque_term ")")
usize_term: (layout_term "." "size" | "(" usize_term ")")
typed_term: (pointer_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | self_term | layout_term | alignment_term | non_null_term | err_term | ok_term | result_term | opaque_term | usize_term)
variant_test: (result_test)
formula: expression
expression: disjunction ("if" disjunction "else" expression)?
disjunction: conjunction ("or" conjunction)*
conjunction: negation ("and" negation)*
negation: ("not" negation | comparison)
comparison: arithmetic (compare arithmetic)*
compare: ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in")
arithmetic: product (("+" | "-") product)*
product: unary (("*" | "//" | "%") unary)*
unary: (("+" | "-"))? primary
primary: (typed_term | integer | string | "True" | "False" | "None" | "(" expression ")" | collection | builtin)
collection: ("[" (expression ("," expression)*)? "]" | "[" expression comprehension "]")
comprehension: "for" identifier "in" disjunction ("if" disjunction)* (comprehension)?
builtin: (("all" | "any") "(" expression ")" | "len" "(" expression ")" | variant_test)
identifier: IDENTIFIER
integer: INTEGER
string: STRING
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
INTEGER: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
%import common.WS
%ignore WS
