maybe_uninit_1_term: ("element" | sequence_1_term "[" index "]" | "(" maybe_uninit_1_term ")")
memory_allocation_term: (memory_storage_2_term "." "allocation" | memory_storage_6_term "." "allocation" | memory_storage_8_term "." "allocation" | memory_storage_4_term "." "allocation" | memory_storage_1_term "." "allocation" | memory_storage_3_term "." "allocation" | memory_storage_5_term "." "allocation" | memory_storage_7_term "." "allocation" | "(" memory_allocation_term ")")
memory_bool_term: (memory_storage_2_term "." "exists" | memory_storage_2_term "." "readable" | memory_storage_2_term "." "writable" | memory_storage_2_term "." "initialized" | memory_storage_2_term "." "valid" | memory_storage_6_term "." "exists" | memory_storage_6_term "." "readable" | memory_storage_6_term "." "writable" | memory_storage_6_term "." "initialized" | memory_storage_6_term "." "valid" | memory_storage_8_term "." "exists" | memory_storage_8_term "." "readable" | memory_storage_8_term "." "writable" | memory_storage_8_term "." "initialized" | memory_storage_8_term "." "valid" | memory_storage_4_term "." "exists" | memory_storage_4_term "." "readable" | memory_storage_4_term "." "writable" | memory_storage_4_term "." "initialized" | memory_storage_4_term "." "valid" | memory_storage_1_term "." "exists" | memory_storage_1_term "." "readable" | memory_storage_1_term "." "writable" | memory_storage_1_term "." "initialized" | memory_storage_1_term "." "valid" | memory_allocation_term "." "exists" | memory_allocation_term "." "live" | memory_storage_3_term "." "exists" | memory_storage_3_term "." "readable" | memory_storage_3_term "." "writable" | memory_storage_3_term "." "initialized" | memory_storage_3_term "." "valid" | memory_storage_5_term "." "exists" | memory_storage_5_term "." "readable" | memory_storage_5_term "." "writable" | memory_storage_5_term "." "initialized" | memory_storage_5_term "." "valid" | memory_storage_7_term "." "exists" | memory_storage_7_term "." "readable" | memory_storage_7_term "." "writable" | memory_storage_7_term "." "initialized" | memory_storage_7_term "." "valid" | "(" memory_bool_term ")")
memory_integer_term: (memory_storage_2_term "." "start" | memory_storage_2_term "." "size" | memory_storage_2_term "." "end" | memory_storage_2_term "." "align" | memory_storage_2_term "." "readable_size" | memory_storage_2_term "." "writable_size" | memory_storage_6_term "." "start" | memory_storage_6_term "." "size" | memory_storage_6_term "." "end" | memory_storage_6_term "." "align" | memory_storage_6_term "." "readable_size" | memory_storage_6_term "." "writable_size" | memory_storage_8_term "." "start" | memory_storage_8_term "." "size" | memory_storage_8_term "." "end" | memory_storage_8_term "." "align" | memory_storage_8_term "." "readable_size" | memory_storage_8_term "." "writable_size" | memory_storage_4_term "." "start" | memory_storage_4_term "." "size" | memory_storage_4_term "." "end" | memory_storage_4_term "." "align" | memory_storage_4_term "." "readable_size" | memory_storage_4_term "." "writable_size" | memory_storage_1_term "." "start" | memory_storage_1_term "." "size" | memory_storage_1_term "." "end" | memory_storage_1_term "." "align" | memory_storage_1_term "." "readable_size" | memory_storage_1_term "." "writable_size" | memory_allocation_term "." "start" | memory_allocation_term "." "size" | memory_allocation_term "." "end" | memory_allocation_term "." "align" | memory_allocation_term "." "minimum_size" | memory_storage_3_term "." "start" | memory_storage_3_term "." "size" | memory_storage_3_term "." "end" | memory_storage_3_term "." "align" | memory_storage_3_term "." "readable_size" | memory_storage_3_term "." "writable_size" | memory_storage_5_term "." "start" | memory_storage_5_term "." "size" | memory_storage_5_term "." "end" | memory_storage_5_term "." "align" | memory_storage_5_term "." "readable_size" | memory_storage_5_term "." "writable_size" | memory_storage_7_term "." "start" | memory_storage_7_term "." "size" | memory_storage_7_term "." "end" | memory_storage_7_term "." "align" | memory_storage_7_term "." "readable_size" | memory_storage_7_term "." "writable_size" | "(" memory_integer_term ")")
memory_storage_1_term: (maybe_uninit_1_term "." "$mem" | "(" memory_storage_1_term ")")
memory_storage_2_term: (sequence_1_term "." "$mem" | "(" memory_storage_2_term ")")
memory_storage_3_term: (sequence_2_term "." "$mem" | "(" memory_storage_3_term ")")
memory_storage_4_term: (into_iter_term "." "$mem" | "(" memory_storage_4_term ")")
memory_storage_5_term: (index_range_term "." "$mem" | "(" memory_storage_5_term ")")
memory_storage_6_term: (range_term "." "$mem" | "(" memory_storage_6_term ")")
memory_storage_7_term: (maybe_uninit_2_term "." "$mem" | "(" memory_storage_7_term ")")
memory_storage_8_term: (usize_term "." "$mem" | "(" memory_storage_8_term ")")
memory_string_term: (memory_allocation_term "." "id" | memory_allocation_term "." "allocator" | "(" memory_string_term ")")
sequence_1_term: ("$1" | "(" sequence_1_term ")")
sequence_2_term: (into_iter_term "." "data" | "(" sequence_2_term ")")
into_iter_term: ("$5" | "(" into_iter_term ")")
index_range_term: (into_iter_term "." "alive" | "(" index_range_term ")")
range_term: ("$2" | "(" range_term ")")
maybe_uninit_2_term: (sequence_2_term "[" index "]" | "(" maybe_uninit_2_term ")")
opaque_term: ("$3" | "(" opaque_term ")")
usize_term: ("$4" | range_term "." "start" | range_term "." "end" | index_range_term "." "start" | index_range_term "." "end" | "(" usize_term ")")
typed_term: (maybe_uninit_1_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_storage_7_term | memory_storage_8_term | memory_string_term | sequence_1_term | sequence_2_term | into_iter_term | index_range_term | range_term | maybe_uninit_2_term | opaque_term | usize_term)
formula: expression
expression: disjunction ("if" disjunction "else" expression)?
disjunction: conjunction ("or" conjunction)*
conjunction: negation ("and" negation)*
negation: ("not" negation | comparison)
comparison: arithmetic (compare arithmetic)*
compare: ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in")
arithmetic: product (("+" | "-") product)*
product: unary (("*" | "//" | "%") unary)*
unary: (("+" | "-"))? primary
primary: (typed_term | integer | string | "True" | "False" | "None" | "(" expression ")" | collection | builtin)
collection: ("[" (expression ("," expression)*)? "]" | "[" expression comprehension "]")
comprehension: "for" identifier "in" disjunction ("if" disjunction)* (comprehension)?
builtin: (("all" | "any") "(" expression ")" | "len" "(" expression ")")
index: index_product (("+" | "-") index_product)*
index_product: index_unary (("*" | "//" | "%") index_unary)*
index_unary: (("+" | "-"))? index_primary
index_primary: (integer | "(" index ")" | "len" "(" expression ")" | memory_integer_term | usize_term)
identifier: IDENTIFIER
integer: INTEGER
string: STRING
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
INTEGER: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
%import common.WS
%ignore WS
