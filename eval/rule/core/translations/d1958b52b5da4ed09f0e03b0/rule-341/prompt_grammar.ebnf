(* Generated concrete EBNF. Every field, tuple position and enum tag is a literal. *)
(* $1 is other: O [argument]. *)
(* $2 is matched: M [argument]. *)
(* $3 is this: * mut T [argument]. *)
(* $4 is discr: < T as DiscriminantKind >::Discriminant [argument]. *)
(* $5 is O: type metadata [type_parameter]. *)
(* $6 is M: type metadata [type_parameter]. *)
(* $7 is T: type metadata [type_parameter]. *)
(* Bare identifier entries are comprehension locals only; scope and element types are checked separately. *)

(* *mut T *)
pointer_term = ("$3" | "(", pointer_term, ")") ;
(* < T as DiscriminantKind >::Discriminant *)
opaque_1_term = ("$4" | "(", opaque_1_term, ")") ;
(* M *)
m_term = ("$2" | "(", m_term, ")") ;
(* MemoryAllocation *)
memory_allocation_term = (memory_storage_4_term, ".", "allocation" | memory_storage_3_term, ".", "allocation" | memory_storage_1_term, ".", "allocation" | memory_storage_2_term, ".", "allocation" | memory_region_term, ".", "allocation" | "(", memory_allocation_term, ")") ;
(* MemoryBool *)
memory_bool_term = (memory_storage_4_term, ".", "exists" | memory_storage_4_term, ".", "readable" | memory_storage_4_term, ".", "writable" | memory_storage_4_term, ".", "initialized" | memory_storage_4_term, ".", "valid" | memory_storage_3_term, ".", "exists" | memory_storage_3_term, ".", "readable" | memory_storage_3_term, ".", "writable" | memory_storage_3_term, ".", "initialized" | memory_storage_3_term, ".", "valid" | memory_storage_1_term, ".", "exists" | memory_storage_1_term, ".", "readable" | memory_storage_1_term, ".", "writable" | memory_storage_1_term, ".", "initialized" | memory_storage_1_term, ".", "valid" | memory_storage_2_term, ".", "exists" | memory_storage_2_term, ".", "readable" | memory_storage_2_term, ".", "writable" | memory_storage_2_term, ".", "initialized" | memory_storage_2_term, ".", "valid" | memory_allocation_term, ".", "exists" | memory_allocation_term, ".", "live" | memory_region_term, ".", "exists" | memory_region_term, ".", "readable" | memory_region_term, ".", "writable" | memory_region_term, ".", "initialized" | memory_region_term, ".", "valid" | "(", memory_bool_term, ")") ;
(* MemoryInteger *)
memory_integer_term = (memory_storage_4_term, ".", "start" | memory_storage_4_term, ".", "size" | memory_storage_4_term, ".", "end" | memory_storage_4_term, ".", "align" | memory_storage_4_term, ".", "readable_size" | memory_storage_4_term, ".", "writable_size" | memory_storage_3_term, ".", "start" | memory_storage_3_term, ".", "size" | memory_storage_3_term, ".", "end" | memory_storage_3_term, ".", "align" | memory_storage_3_term, ".", "readable_size" | memory_storage_3_term, ".", "writable_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | memory_region_term, ".", "start" | memory_region_term, ".", "size" | memory_region_term, ".", "end" | memory_region_term, ".", "align" | memory_region_term, ".", "readable_size" | memory_region_term, ".", "writable_size" | "(", memory_integer_term, ")") ;
(* MemoryRegion<T> *)
memory_region_term = (memory_storage_1_term, ".", "pointee" | "(", memory_region_term, ")") ;
(* MemoryStorage<*mut T> *)
memory_storage_1_term = (pointer_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<< T as DiscriminantKind >::Discriminant> *)
memory_storage_2_term = (opaque_1_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<M> *)
memory_storage_3_term = (m_term, ".", "$mem" | "(", memory_storage_3_term, ")") ;
(* MemoryStorage<O> *)
memory_storage_4_term = (o_term, ".", "$mem" | "(", memory_storage_4_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* O *)
o_term = ("$1" | "(", o_term, ")") ;
(* type parameter M *)
opaque_2_term = ("$6" | "(", opaque_2_term, ")") ;
(* type parameter O *)
opaque_3_term = ("$5" | "(", opaque_3_term, ")") ;
(* type parameter T *)
opaque_4_term = ("$7" | "(", opaque_4_term, ")") ;
typed_term = (pointer_term | opaque_1_term | m_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_region_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_string_term | o_term | opaque_2_term | opaque_3_term | opaque_4_term) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")") ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
