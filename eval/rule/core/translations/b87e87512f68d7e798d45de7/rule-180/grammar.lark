memory_storage_1_term: (pointer_1_term "." "$mem" | "(" memory_storage_1_term ")")
memory_storage_2_term: (pointer_2_term "." "$mem" | "(" memory_storage_2_term ")")
memory_storage_3_term: (self_term "." "$mem" | "(" memory_storage_3_term ")")
memory_storage_4_term: (alloc_error_term "." "$mem" | "(" memory_storage_4_term ")")
memory_storage_5_term: (layout_term "." "$mem" | "(" memory_storage_5_term ")")
memory_storage_6_term: (alignment_term "." "$mem" | "(" memory_storage_6_term ")")
memory_storage_7_term: (alignment_enum_term "." "$mem" | "(" memory_storage_7_term ")")
memory_storage_8_term: (non_null_1_term "." "$mem" | "(" memory_storage_8_term ")")
memory_storage_9_term: (non_null_2_term "." "$mem" | "(" memory_storage_9_term ")")
memory_storage_10_term: (err_term "." "$mem" | "(" memory_storage_10_term ")")
memory_storage_11_term: (ok_term "." "$mem" | "(" memory_storage_11_term ")")
memory_storage_12_term: (result_term "." "$mem" | "(" memory_storage_12_term ")")
memory_storage_13_term: (usize_term "." "$mem" | "(" memory_storage_13_term ")")
memory_string_term: (memory_allocation_term "." "id" | memory_allocation_term "." "allocator" | "(" memory_string_term ")")
self_term: ("$1" | "(" self_term ")")
alloc_error_term: (err_term "[" "0" "]" | "(" alloc_error_term ")")
layout_term: ("$3" | "$4" | "(" layout_term ")")
alignment_term: (layout_term "." "align" | "(" alignment_term ")")
alignment_enum_term: (alignment_term "[" "0" "]" | "(" alignment_enum_term ")")
non_null_1_term: (ok_term "[" "0" "]" | "(" non_null_1_term ")")
non_null_2_term: ("$2" | "(" non_null_2_term ")")
err_term: (result_term "." "Err" | "(" err_term ")")
ok_term: (result_term "." "Ok" | "(" ok_term ")")
result_term: ("$6" | "(" result_term ")")
result_variant: ("\"Ok\"" | "'Ok'" | "\"Err\"" | "'Err'")
result_test: "is_variant" "(" result_term "," result_variant ")"
opaque_term: ("$5" | "(" opaque_term ")")
usize_term: (layout_term "." "size" | "(" usize_term ")")
typed_term: (pointer_1_term | pointer_2_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_region_1_term | memory_region_2_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_storage_7_term | memory_storage_8_term | memory_storage_9_term | memory_storage_10_term | memory_storage_11_term | memory_storage_12_term | memory_storage_13_term | memory_string_term | self_term | alloc_error_term | layout_term | alignment_term | alignment_enum_term | non_null_1_term | non_null_2_term | err_term | ok_term | result_term | opaque_term | usize_term)
variant_test: (result_test)
formula: expression
expression: disjunction ("if" disjunction "else" expression)?
disjunction: conjunction ("or" conjunction)*
conjunction: negation ("and" negation)*
negation: ("not" negation | comparison)
comparison: arithmetic (compare arithmetic)*
compare: ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in")
arithmetic: product (("+" | "-") product)*
product: unary (("*" | "//" | "%") unary)*
unary: (("+" | "-"))? primary
primary: (typed_term | integer | string | "True" | "False" | "None" | "(" expression ")" | collection | builtin)
collection: ("[" (expression ("," expression)*)? "]" | "[" expression comprehension "]")
comprehension: "for" identifier "in" disjunction ("if" disjunction)* (comprehension)?
builtin: (("all" | "any") "(" expression ")" | "len" "(" expression ")" | variant_test)
identifier: IDENTIFIER
integer: INTEGER
string: STRING
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
INTEGER: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
%import common.WS
%ignore WS
