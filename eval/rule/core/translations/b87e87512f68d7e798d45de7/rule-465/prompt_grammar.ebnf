(* Generated concrete EBNF. Every field, tuple position and enum tag is a literal. *)
(* $1 is self: * const [T] [argument]. *)
(* $2 is index: I [argument]. *)
(* $3 is T: type metadata [type_parameter]. *)
(* $4 is I: type metadata [type_parameter]. *)
(* $5 is result: * const I::Output [return_value]. *)
(* Bare identifier entries are comprehension locals only; scope and element types are checked separately. *)

(* *const I::Output *)
pointer_1_term = ("$5" | "(", pointer_1_term, ")") ;
(* *const [T] *)
pointer_2_term = ("$1" | "(", pointer_2_term, ")") ;
(* I *)
i_term = ("$2" | "(", i_term, ")") ;
(* MemoryAllocation *)
memory_allocation_term = (memory_storage_2_term, ".", "allocation" | memory_storage_3_term, ".", "allocation" | memory_storage_1_term, ".", "allocation" | memory_region_2_term, ".", "allocation" | memory_region_1_term, ".", "allocation" | "(", memory_allocation_term, ")") ;
(* MemoryBool *)
memory_bool_term = (memory_storage_2_term, ".", "exists" | memory_storage_2_term, ".", "readable" | memory_storage_2_term, ".", "writable" | memory_storage_2_term, ".", "initialized" | memory_storage_2_term, ".", "valid" | memory_storage_3_term, ".", "exists" | memory_storage_3_term, ".", "readable" | memory_storage_3_term, ".", "writable" | memory_storage_3_term, ".", "initialized" | memory_storage_3_term, ".", "valid" | memory_storage_1_term, ".", "exists" | memory_storage_1_term, ".", "readable" | memory_storage_1_term, ".", "writable" | memory_storage_1_term, ".", "initialized" | memory_storage_1_term, ".", "valid" | memory_allocation_term, ".", "exists" | memory_allocation_term, ".", "live" | memory_region_2_term, ".", "exists" | memory_region_2_term, ".", "readable" | memory_region_2_term, ".", "writable" | memory_region_2_term, ".", "initialized" | memory_region_2_term, ".", "valid" | memory_region_1_term, ".", "exists" | memory_region_1_term, ".", "readable" | memory_region_1_term, ".", "writable" | memory_region_1_term, ".", "initialized" | memory_region_1_term, ".", "valid" | "(", memory_bool_term, ")") ;
(* MemoryInteger *)
memory_integer_term = (memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_storage_3_term, ".", "start" | memory_storage_3_term, ".", "size" | memory_storage_3_term, ".", "end" | memory_storage_3_term, ".", "align" | memory_storage_3_term, ".", "readable_size" | memory_storage_3_term, ".", "writable_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | memory_region_2_term, ".", "start" | memory_region_2_term, ".", "size" | memory_region_2_term, ".", "end" | memory_region_2_term, ".", "align" | memory_region_2_term, ".", "readable_size" | memory_region_2_term, ".", "writable_size" | memory_region_1_term, ".", "start" | memory_region_1_term, ".", "size" | memory_region_1_term, ".", "end" | memory_region_1_term, ".", "align" | memory_region_1_term, ".", "readable_size" | memory_region_1_term, ".", "writable_size" | "(", memory_integer_term, ")") ;
(* MemoryRegion<I::Output> *)
memory_region_1_term = (memory_storage_1_term, ".", "pointee" | "(", memory_region_1_term, ")") ;
(* MemoryRegion<[T]> *)
memory_region_2_term = (memory_storage_2_term, ".", "pointee" | "(", memory_region_2_term, ")") ;
(* MemoryStorage<*const I::Output> *)
memory_storage_1_term = (pointer_1_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<*const [T]> *)
memory_storage_2_term = (pointer_2_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<I> *)
memory_storage_3_term = (i_term, ".", "$mem" | "(", memory_storage_3_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* type parameter I *)
opaque_1_term = ("$4" | "(", opaque_1_term, ")") ;
(* type parameter T *)
opaque_2_term = ("$3" | "(", opaque_2_term, ")") ;
typed_term = (pointer_1_term | pointer_2_term | i_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_region_1_term | memory_region_2_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_string_term | opaque_1_term | opaque_2_term) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")") ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
