(* Generated concrete EBNF. Every field, tuple position and enum tag is a literal. *)
(* $1 is bytes: & [u8] [argument]. *)
(* $2 is result: & core::ffi::c_str::CStr [return_value]. *)
(* Bare identifier entries are comprehension locals only; scope and element types are checked separately. *)

(* MemoryAllocation *)
memory_allocation_term = (memory_storage_2_term, ".", "allocation" | memory_storage_3_term, ".", "allocation" | memory_storage_5_term, ".", "allocation" | memory_storage_1_term, ".", "allocation" | memory_storage_4_term, ".", "allocation" | "(", memory_allocation_term, ")") ;
(* MemoryBool *)
memory_bool_term = (memory_storage_2_term, ".", "exists" | memory_storage_2_term, ".", "readable" | memory_storage_2_term, ".", "writable" | memory_storage_2_term, ".", "initialized" | memory_storage_2_term, ".", "valid" | memory_storage_3_term, ".", "exists" | memory_storage_3_term, ".", "readable" | memory_storage_3_term, ".", "writable" | memory_storage_3_term, ".", "initialized" | memory_storage_3_term, ".", "valid" | memory_storage_5_term, ".", "exists" | memory_storage_5_term, ".", "readable" | memory_storage_5_term, ".", "writable" | memory_storage_5_term, ".", "initialized" | memory_storage_5_term, ".", "valid" | memory_allocation_term, ".", "exists" | memory_allocation_term, ".", "live" | memory_storage_1_term, ".", "exists" | memory_storage_1_term, ".", "readable" | memory_storage_1_term, ".", "writable" | memory_storage_1_term, ".", "initialized" | memory_storage_1_term, ".", "valid" | memory_storage_4_term, ".", "exists" | memory_storage_4_term, ".", "readable" | memory_storage_4_term, ".", "writable" | memory_storage_4_term, ".", "initialized" | memory_storage_4_term, ".", "valid" | "(", memory_bool_term, ")") ;
(* MemoryInteger *)
memory_integer_term = (memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_storage_3_term, ".", "start" | memory_storage_3_term, ".", "size" | memory_storage_3_term, ".", "end" | memory_storage_3_term, ".", "align" | memory_storage_3_term, ".", "readable_size" | memory_storage_3_term, ".", "writable_size" | memory_storage_5_term, ".", "start" | memory_storage_5_term, ".", "size" | memory_storage_5_term, ".", "end" | memory_storage_5_term, ".", "align" | memory_storage_5_term, ".", "readable_size" | memory_storage_5_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | memory_storage_4_term, ".", "start" | memory_storage_4_term, ".", "size" | memory_storage_4_term, ".", "end" | memory_storage_4_term, ".", "align" | memory_storage_4_term, ".", "readable_size" | memory_storage_4_term, ".", "writable_size" | "(", memory_integer_term, ")") ;
(* MemoryStorage<[ffi::c_char]> *)
memory_storage_1_term = (sequence_1_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<[u8]> *)
memory_storage_2_term = (sequence_2_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<core::ffi::c_str::CStr> *)
memory_storage_3_term = (cstr_term, ".", "$mem" | "(", memory_storage_3_term, ")") ;
(* MemoryStorage<ffi::c_char> *)
memory_storage_4_term = (c_char_term, ".", "$mem" | "(", memory_storage_4_term, ")") ;
(* MemoryStorage<u8> *)
memory_storage_5_term = (u8_term, ".", "$mem" | "(", memory_storage_5_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* [ffi::c_char] *)
sequence_1_term = (cstr_term, ".", "inner" | "(", sequence_1_term, ")") ;
(* [u8] *)
sequence_2_term = ("$1" | "(", sequence_2_term, ")") ;
(* core::ffi::c_str::CStr *)
cstr_term = ("$2" | "(", cstr_term, ")") ;
(* ffi::c_char *)
c_char_term = (identifier | sequence_1_term, "[", index, "]" | "(", c_char_term, ")") ;
(* u8 *)
u8_term = (identifier | sequence_2_term, "[", index, "]" | "(", u8_term, ")") ;
typed_term = (memory_allocation_term | memory_bool_term | memory_integer_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_string_term | sequence_1_term | sequence_2_term | cstr_term | c_char_term | u8_term) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")") ;
index = index_product, { ("+" | "-"), index_product } ;
index_product = index_unary, { ("*" | "//" | "%"), index_unary } ;
index_unary = [ ("+" | "-") ], index_primary ;
index_primary = (integer | "(", index, ")" | "len", "(", expression, ")" | memory_integer_term | u8_term) ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
