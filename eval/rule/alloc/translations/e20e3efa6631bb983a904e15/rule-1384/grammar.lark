pointer_term: (non_null_term "." "pointer" | "(" pointer_term ")")
a_term: (arc_term "." "alloc" | some_term "[" "0" "]" | "(" a_term ")")
memory_allocation_term: (memory_storage_5_term "." "allocation" | memory_storage_4_term "." "allocation" | memory_storage_9_term "." "allocation" | memory_storage_3_term "." "allocation" | memory_storage_8_term "." "allocation" | memory_storage_6_term "." "allocation" | memory_storage_2_term "." "allocation" | memory_storage_1_term "." "allocation" | memory_region_term "." "allocation" | memory_storage_7_term "." "allocation" | "(" memory_allocation_term ")")
memory_bool_term: (memory_storage_5_term "." "exists" | memory_storage_5_term "." "readable" | memory_storage_5_term "." "writable" | memory_storage_5_term "." "initialized" | memory_storage_5_term "." "valid" | memory_storage_4_term "." "exists" | memory_storage_4_term "." "readable" | memory_storage_4_term "." "writable" | memory_storage_4_term "." "initialized" | memory_storage_4_term "." "valid" | memory_storage_9_term "." "exists" | memory_storage_9_term "." "readable" | memory_storage_9_term "." "writable" | memory_storage_9_term "." "initialized" | memory_storage_9_term "." "valid" | memory_storage_3_term "." "exists" | memory_storage_3_term "." "readable" | memory_storage_3_term "." "writable" | memory_storage_3_term "." "initialized" | memory_storage_3_term "." "valid" | memory_storage_8_term "." "exists" | memory_storage_8_term "." "readable" | memory_storage_8_term "." "writable" | memory_storage_8_term "." "initialized" | memory_storage_8_term "." "valid" | memory_allocation_term "." "exists" | memory_allocation_term "." "live" | memory_storage_6_term "." "exists" | memory_storage_6_term "." "readable" | memory_storage_6_term "." "writable" | memory_storage_6_term "." "initialized" | memory_storage_6_term "." "valid" | memory_storage_2_term "." "exists" | memory_storage_2_term "." "readable" | memory_storage_2_term "." "writable" | memory_storage_2_term "." "initialized" | memory_storage_2_term "." "valid" | memory_storage_1_term "." "exists" | memory_storage_1_term "." "readable" | memory_storage_1_term "." "writable" | memory_storage_1_term "." "initialized" | memory_storage_1_term "." "valid" | memory_region_term "." "exists" | memory_region_term "." "readable" | memory_region_term "." "writable" | memory_region_term "." "initialized" | memory_region_term "." "valid" | memory_storage_7_term "." "exists" | memory_storage_7_term "." "readable" | memory_storage_7_term "." "writable" | memory_storage_7_term "." "initialized" | memory_storage_7_term "." "valid" | "(" memory_bool_term ")")
memory_integer_term: (memory_storage_5_term "." "start" | memory_storage_5_term "." "size" | memory_storage_5_term "." "end" | memory_storage_5_term "." "align" | memory_storage_5_term "." "readable_size" | memory_storage_5_term "." "writable_size" | memory_storage_4_term "." "start" | memory_storage_4_term "." "size" | memory_storage_4_term "." "end" | memory_storage_4_term "." "align" | memory_storage_4_term "." "readable_size" | memory_storage_4_term "." "writable_size" | memory_storage_9_term "." "start" | memory_storage_9_term "." "size" | memory_storage_9_term "." "end" | memory_storage_9_term "." "align" | memory_storage_9_term "." "readable_size" | memory_storage_9_term "." "writable_size" | memory_storage_3_term "." "start" | memory_storage_3_term "." "size" | memory_storage_3_term "." "end" | memory_storage_3_term "." "align" | memory_storage_3_term "." "readable_size" | memory_storage_3_term "." "writable_size" | memory_storage_8_term "." "start" | memory_storage_8_term "." "size" | memory_storage_8_term "." "end" | memory_storage_8_term "." "align" | memory_storage_8_term "." "readable_size" | memory_storage_8_term "." "writable_size" | memory_allocation_term "." "start" | memory_allocation_term "." "size" | memory_allocation_term "." "end" | memory_allocation_term "." "align" | memory_allocation_term "." "minimum_size" | memory_storage_6_term "." "start" | memory_storage_6_term "." "size" | memory_storage_6_term "." "end" | memory_storage_6_term "." "align" | memory_storage_6_term "." "readable_size" | memory_storage_6_term "." "writable_size" | memory_storage_2_term "." "start" | memory_storage_2_term "." "size" | memory_storage_2_term "." "end" | memory_storage_2_term "." "align" | memory_storage_2_term "." "readable_size" | memory_storage_2_term "." "writable_size" | memory_storage_1_term "." "start" | memory_storage_1_term "." "size" | memory_storage_1_term "." "end" | memory_storage_1_term "." "align" | memory_storage_1_term "." "readable_size" | memory_storage_1_term "." "writable_size" | memory_region_term "." "start" | memory_region_term "." "size" | memory_region_term "." "end" | memory_region_term "." "align" | memory_region_term "." "readable_size" | memory_region_term "." "writable_size" | memory_storage_7_term "." "start" | memory_storage_7_term "." "size" | memory_storage_7_term "." "end" | memory_storage_7_term "." "align" | memory_storage_7_term "." "readable_size" | memory_storage_7_term "." "writable_size" | "(" memory_integer_term ")")
memory_region_term: (memory_storage_9_term "." "pointee" | memory_storage_1_term "." "pointee" | "(" memory_region_term ")")
memory_storage_1_term: (pointer_term "." "$mem" | "(" memory_storage_1_term ")")
memory_storage_2_term: (a_term "." "$mem" | "(" memory_storage_2_term ")")
memory_storage_3_term: (layout_term "." "$mem" | "(" memory_storage_3_term ")")
memory_storage_4_term: (arc_term "." "$mem" | "(" memory_storage_4_term ")")
memory_storage_5_term: (unique_arc_uninit_term "." "$mem" | "(" memory_storage_5_term ")")
memory_storage_6_term: (phantom_data_term "." "$mem" | "(" memory_storage_6_term ")")
memory_storage_7_term: (some_term "." "$mem" | "(" memory_storage_7_term ")")
memory_storage_8_term: (option_term "." "$mem" | "(" memory_storage_8_term ")")
memory_storage_9_term: (non_null_term "." "$mem" | "(" memory_storage_9_term ")")
memory_string_term: (memory_allocation_term "." "id" | memory_allocation_term "." "allocator" | "(" memory_string_term ")")
layout_term: (unique_arc_uninit_term "." "layout_for_value" | "(" layout_term ")")
arc_term: ("$4" | "(" arc_term ")")
unique_arc_uninit_term: ("$1" | "(" unique_arc_uninit_term ")")
phantom_data_term: (arc_term "." "phantom" | "(" phantom_data_term ")")
some_term: (option_term "." "Some" | "(" some_term ")")
option_term: (unique_arc_uninit_term "." "alloc" | "(" option_term ")")
option_variant: ("\"None\"" | "'None'" | "\"Some\"" | "'Some'")
option_test: "is_variant" "(" option_term "," option_variant ")"
non_null_term: (unique_arc_uninit_term "." "ptr" | arc_term "." "ptr" | "(" non_null_term ")")
opaque_1_term: ("$3" | "(" opaque_1_term ")")
opaque_2_term: ("$2" | "(" opaque_2_term ")")
typed_term: (pointer_term | a_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_region_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_storage_7_term | memory_storage_8_term | memory_storage_9_term | memory_string_term | layout_term | arc_term | unique_arc_uninit_term | phantom_data_term | some_term | option_term | non_null_term | opaque_1_term | opaque_2_term)
variant_test: (option_test)
formula: expression
expression: disjunction ("if" disjunction "else" expression)?
disjunction: conjunction ("or" conjunction)*
conjunction: negation ("and" negation)*
negation: ("not" negation | comparison)
comparison: arithmetic (compare arithmetic)*
compare: ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in")
arithmetic: product (("+" | "-") product)*
product: unary (("*" | "//" | "%") unary)*
unary: (("+" | "-"))? primary
primary: (typed_term | integer | string | "True" | "False" | "None" | "(" expression ")" | collection | builtin)
collection: ("[" (expression ("," expression)*)? "]" | "[" expression comprehension "]")
comprehension: "for" identifier "in" disjunction ("if" disjunction)* (comprehension)?
builtin: (("all" | "any") "(" expression ")" | "len" "(" expression ")" | variant_test)
identifier: IDENTIFIER
integer: INTEGER
string: STRING
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
INTEGER: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
%import common.WS
%ignore WS
