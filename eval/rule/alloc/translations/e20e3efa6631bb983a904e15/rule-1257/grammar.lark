memory_integer_term: (memory_storage_1_term "." "start" | memory_storage_1_term "." "size" | memory_storage_1_term "." "end" | memory_storage_1_term "." "align" | memory_storage_1_term "." "readable_size" | memory_storage_1_term "." "writable_size" | memory_storage_10_term "." "start" | memory_storage_10_term "." "size" | memory_storage_10_term "." "end" | memory_storage_10_term "." "align" | memory_storage_10_term "." "readable_size" | memory_storage_10_term "." "writable_size" | memory_storage_2_term "." "start" | memory_storage_2_term "." "size" | memory_storage_2_term "." "end" | memory_storage_2_term "." "align" | memory_storage_2_term "." "readable_size" | memory_storage_2_term "." "writable_size" | memory_storage_3_term "." "start" | memory_storage_3_term "." "size" | memory_storage_3_term "." "end" | memory_storage_3_term "." "align" | memory_storage_3_term "." "readable_size" | memory_storage_3_term "." "writable_size" | memory_allocation_term "." "start" | memory_allocation_term "." "size" | memory_allocation_term "." "end" | memory_allocation_term "." "align" | memory_allocation_term "." "minimum_size" | memory_region_1_term "." "start" | memory_region_1_term "." "size" | memory_region_1_term "." "end" | memory_region_1_term "." "align" | memory_region_1_term "." "readable_size" | memory_region_1_term "." "writable_size" | memory_storage_4_term "." "start" | memory_storage_4_term "." "size" | memory_storage_4_term "." "end" | memory_storage_4_term "." "align" | memory_storage_4_term "." "readable_size" | memory_storage_4_term "." "writable_size" | memory_storage_5_term "." "start" | memory_storage_5_term "." "size" | memory_storage_5_term "." "end" | memory_storage_5_term "." "align" | memory_storage_5_term "." "readable_size" | memory_storage_5_term "." "writable_size" | memory_storage_9_term "." "start" | memory_storage_9_term "." "size" | memory_storage_9_term "." "end" | memory_storage_9_term "." "align" | memory_storage_9_term "." "readable_size" | memory_storage_9_term "." "writable_size" | memory_storage_7_term "." "start" | memory_storage_7_term "." "size" | memory_storage_7_term "." "end" | memory_storage_7_term "." "align" | memory_storage_7_term "." "readable_size" | memory_storage_7_term "." "writable_size" | "(" memory_integer_term ")")
