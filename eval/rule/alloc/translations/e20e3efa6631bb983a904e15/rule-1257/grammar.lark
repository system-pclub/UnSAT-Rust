memory_region_2_term: (memory_storage_9_term "." "pointee" | "(" memory_region_2_term ")")
memory_storage_1_term: (pointer_2_term "." "$mem" | "(" memory_storage_1_term ")")
memory_storage_2_term: (a_term "." "$mem" | "(" memory_storage_2_term ")")
memory_storage_3_term: (raw_vec_term "." "$mem" | "(" memory_storage_3_term ")")
memory_storage_4_term: (raw_vec_inner_term "." "$mem" | "(" memory_storage_4_term ")")
memory_storage_5_term: (phantom_data_1_term "." "$mem" | "(" memory_storage_5_term ")")
memory_storage_6_term: (phantom_data_2_term "." "$mem" | "(" memory_storage_6_term ")")
memory_storage_7_term: (cap_term "." "$mem" | "(" memory_storage_7_term ")")
memory_storage_8_term: (non_null_term "." "$mem" | "(" memory_storage_8_term ")")
memory_storage_9_term: (unique_term "." "$mem" | "(" memory_storage_9_term ")")
memory_storage_10_term: (usize_term "." "$mem" | "(" memory_storage_10_term ")")
