raw_vec_term: ("$6" | "(" raw_vec_term ")")
raw_vec_inner_term: (raw_vec_term "." "inner" | "(" raw_vec_inner_term ")")
phantom_data_1_term: (raw_vec_term "." "_marker" | "(" phantom_data_1_term ")")
phantom_data_2_term: (unique_term "." "_marker" | "(" phantom_data_2_term ")")
non_null_term: (unique_term "." "pointer" | "(" non_null_term ")")
unique_term: (raw_vec_inner_term "." "ptr" | "(" unique_term ")")
opaque_1_term: ("$5" | "(" opaque_1_term ")")
opaque_2_term: ("$4" | "(" opaque_2_term ")")
usize_term: ("$2" | "(" usize_term ")")
typed_term: (pointer_1_term | pointer_2_term | a_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_region_1_term | memory_region_2_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_storage_7_term | memory_storage_8_term | memory_storage_9_term | memory_storage_10_term | memory_string_term | cap_term | raw_vec_term | raw_vec_inner_term | phantom_data_1_term | phantom_data_2_term | non_null_term | unique_term | opaque_1_term | opaque_2_term | usize_term)
formula: expression
expression: disjunction ("if" disjunction "else" expression)?
disjunction: conjunction ("or" conjunction)*
conjunction: negation ("and" negation)*
negation: ("not" negation | comparison)
comparison: arithmetic (compare arithmetic)*
compare: ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in")
arithmetic: product (("+" | "-") product)*
product: unary (("*" | "//" | "%") unary)*
unary: (("+" | "-"))? primary
primary: (typed_term | integer | string | "True" | "False" | "None" | "(" expression ")" | collection | builtin)
collection: ("[" (expression ("," expression)*)? "]" | "[" expression comprehension "]")
comprehension: "for" identifier "in" disjunction ("if" disjunction)* (comprehension)?
builtin: (("all" | "any") "(" expression ")" | "len" "(" expression ")")
identifier: IDENTIFIER
integer: INTEGER
string: STRING
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
INTEGER: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
%import common.WS
%ignore WS
