a_term: (box_term "[" "1" "]" | "(" a_term ")")
memory_storage_1_term: (box_term "." "$mem" | "(" memory_storage_1_term ")")
memory_storage_2_term: (node_ref_term "." "$mem" | "(" memory_storage_2_term ")")
memory_storage_3_term: (usize_term "." "$mem" | "(" memory_storage_3_term ")")
box_term: ("$1" | "(" box_term ")")
node_ref_term: ("$6" | "(" node_ref_term ")")
phantom_data_term: (node_ref_term "." "_marker" | "(" phantom_data_term ")")
non_null_term: (node_ref_term "." "node" | "(" non_null_term ")")
unique_term: (box_term "[" "0" "]" | "(" unique_term ")")
opaque_1_term: ("$5" | "(" opaque_1_term ")")
opaque_2_term: ("$3" | "(" opaque_2_term ")")
opaque_3_term: ("$4" | "(" opaque_3_term ")")
usize_term: ("$2" | node_ref_term "." "height" | "(" usize_term ")")
typed_term: (a_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | box_term | node_ref_term | phantom_data_term | non_null_term | unique_term | opaque_1_term | opaque_2_term | opaque_3_term | usize_term)
formula: expression
expression: disjunction ("if" disjunction "else" expression)?
disjunction: conjunction ("or" conjunction)*
conjunction: negation ("and" negation)*
negation: ("not" negation | comparison)
comparison: arithmetic (compare arithmetic)*
compare: ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in")
arithmetic: product (("+" | "-") product)*
product: unary (("*" | "//" | "%") unary)*
unary: (("+" | "-"))? primary
primary: (typed_term | integer | string | "True" | "False" | "None" | "(" expression ")" | collection | builtin)
collection: ("[" (expression ("," expression)*)? "]" | "[" expression comprehension "]")
comprehension: "for" identifier "in" disjunction ("if" disjunction)* (comprehension)?
builtin: (("all" | "any") "(" expression ")" | "len" "(" expression ")")
identifier: IDENTIFIER
integer: INTEGER
string: STRING
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
INTEGER: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
%import common.WS
%ignore WS
