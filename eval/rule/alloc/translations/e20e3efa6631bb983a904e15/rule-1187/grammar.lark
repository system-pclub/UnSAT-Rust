a_term: ("$2" | "(" a_term ")")
memory_allocation_term: (memory_storage_2_term "." "allocation" | memory_storage_1_term "." "allocation" | memory_storage_3_term "." "allocation" | "(" memory_allocation_term ")")
memory_bool_term: (memory_storage_2_term "." "exists" | memory_storage_2_term "." "readable" | memory_storage_2_term "." "writable" | memory_storage_2_term "." "initialized" | memory_storage_2_term "." "valid" | memory_storage_1_term "." "exists" | memory_storage_1_term "." "readable" | memory_storage_1_term "." "writable" | memory_storage_1_term "." "initialized" | memory_storage_1_term "." "valid" | memory_storage_3_term "." "exists" | memory_storage_3_term "." "readable" | memory_storage_3_term "." "writable" | memory_storage_3_term "." "initialized" | memory_storage_3_term "." "valid" | "(" memory_bool_term ")")
memory_integer_term: (memory_storage_2_term "." "start" | memory_storage_2_term "." "size" | memory_storage_2_term "." "end" | memory_storage_2_term "." "align" | memory_storage_2_term "." "readable_size" | memory_storage_2_term "." "writable_size" | memory_storage_1_term "." "start" | memory_storage_1_term "." "size" | memory_storage_1_term "." "end" | memory_storage_1_term "." "align" | memory_storage_1_term "." "readable_size" | memory_storage_1_term "." "writable_size" | memory_storage_3_term "." "start" | memory_storage_3_term "." "size" | memory_storage_3_term "." "end" | memory_storage_3_term "." "align" | memory_storage_3_term "." "readable_size" | memory_storage_3_term "." "writable_size" | "(" memory_integer_term ")")
memory_storage_1_term: (a_term "." "$mem" | "(" memory_storage_1_term ")")
memory_storage_2_term: (handle_1_term "." "$mem" | "(" memory_storage_2_term ")")
memory_storage_3_term: (handle_2_term "." "$mem" | "(" memory_storage_3_term ")")
memory_storage_4_term: (node_ref_1_term "." "$mem" | "(" memory_storage_4_term ")")
memory_storage_5_term: (node_ref_2_term "." "$mem" | "(" memory_storage_5_term ")")
memory_storage_6_term: (phantom_data_3_term "." "$mem" | "(" memory_storage_6_term ")")
memory_storage_7_term: (phantom_data_4_term "." "$mem" | "(" memory_storage_7_term ")")
memory_storage_8_term: (usize_term "." "$mem" | "(" memory_storage_8_term ")")
handle_1_term: ("$1" | "(" handle_1_term ")")
handle_2_term: ("$6" | "(" handle_2_term ")")
node_ref_1_term: (handle_1_term "." "node" | "(" node_ref_1_term ")")
node_ref_2_term: (handle_2_term "." "node" | "(" node_ref_2_term ")")
phantom_data_1_term: (node_ref_1_term "." "_marker" | "(" phantom_data_1_term ")")
phantom_data_2_term: (node_ref_2_term "." "_marker" | "(" phantom_data_2_term ")")
phantom_data_3_term: (handle_1_term "." "_marker" | "(" phantom_data_3_term ")")
phantom_data_4_term: (handle_2_term "." "_marker" | "(" phantom_data_4_term ")")
non_null_term: (node_ref_1_term "." "node" | node_ref_2_term "." "node" | "(" non_null_term ")")
opaque_1_term: ("$5" | "(" opaque_1_term ")")
opaque_2_term: ("$3" | "(" opaque_2_term ")")
opaque_3_term: ("$4" | "(" opaque_3_term ")")
usize_term: (handle_1_term "." "idx" | handle_2_term "." "idx" | node_ref_1_term "." "height" | node_ref_2_term "." "height" | "(" usize_term ")")
typed_term: (a_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_storage_7_term | memory_storage_8_term | handle_1_term | handle_2_term | node_ref_1_term | node_ref_2_term | phantom_data_1_term | phantom_data_2_term | phantom_data_3_term | phantom_data_4_term | non_null_term | opaque_1_term | opaque_2_term | opaque_3_term | usize_term)
formula: expression
expression: disjunction ("if" disjunction "else" expression)?
disjunction: conjunction ("or" conjunction)*
conjunction: negation ("and" negation)*
negation: ("not" negation | comparison)
comparison: arithmetic (compare arithmetic)*
compare: ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in")
arithmetic: product (("+" | "-") product)*
product: unary (("*" | "//" | "%") unary)*
unary: (("+" | "-"))? primary
primary: (typed_term | integer | string | "True" | "False" | "None" | "(" expression ")" | collection | builtin)
collection: ("[" (expression ("," expression)*)? "]" | "[" expression comprehension "]")
comprehension: "for" identifier "in" disjunction ("if" disjunction)* (comprehension)?
builtin: (("all" | "any") "(" expression ")" | "len" "(" expression ")")
identifier: IDENTIFIER
integer: INTEGER
string: STRING
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
INTEGER: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
%import common.WS
%ignore WS
