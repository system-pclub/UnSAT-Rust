memory_allocation_term: (memory_storage_8_term "." "allocation" | memory_storage_3_term "." "allocation" | memory_storage_9_term "." "allocation" | memory_storage_4_term "." "allocation" | memory_storage_6_term "." "allocation" | memory_storage_7_term "." "allocation" | memory_storage_1_term "." "allocation" | memory_storage_5_term "." "allocation" | memory_storage_2_term "." "allocation" | "(" memory_allocation_term ")")
memory_bool_term: (memory_storage_8_term "." "exists" | memory_storage_8_term "." "readable" | memory_storage_8_term "." "writable" | memory_storage_8_term "." "initialized" | memory_storage_8_term "." "valid" | memory_storage_3_term "." "exists" | memory_storage_3_term "." "readable" | memory_storage_3_term "." "writable" | memory_storage_3_term "." "initialized" | memory_storage_3_term "." "valid" | memory_storage_9_term "." "exists" | memory_storage_9_term "." "readable" | memory_storage_9_term "." "writable" | memory_storage_9_term "." "initialized" | memory_storage_9_term "." "valid" | memory_storage_4_term "." "exists" | memory_storage_4_term "." "readable" | memory_storage_4_term "." "writable" | memory_storage_4_term "." "initialized" | memory_storage_4_term "." "valid" | memory_storage_6_term "." "exists" | memory_storage_6_term "." "readable" | memory_storage_6_term "." "writable" | memory_storage_6_term "." "initialized" | memory_storage_6_term "." "valid" | memory_storage_7_term "." "exists" | memory_storage_7_term "." "readable" | memory_storage_7_term "." "writable" | memory_storage_7_term "." "initialized" | memory_storage_7_term "." "valid" | memory_allocation_term "." "exists" | memory_allocation_term "." "live" | memory_storage_1_term "." "exists" | memory_storage_1_term "." "readable" | memory_storage_1_term "." "writable" | memory_storage_1_term "." "initialized" | memory_storage_1_term "." "valid" | memory_storage_5_term "." "exists" | memory_storage_5_term "." "readable" | memory_storage_5_term "." "writable" | memory_storage_5_term "." "initialized" | memory_storage_5_term "." "valid" | memory_storage_2_term "." "exists" | memory_storage_2_term "." "readable" | memory_storage_2_term "." "writable" | memory_storage_2_term "." "initialized" | memory_storage_2_term "." "valid" | "(" memory_bool_term ")")
memory_integer_term: (memory_storage_8_term "." "start" | memory_storage_8_term "." "size" | memory_storage_8_term "." "end" | memory_storage_8_term "." "align" | memory_storage_8_term "." "readable_size" | memory_storage_8_term "." "writable_size" | memory_storage_3_term "." "start" | memory_storage_3_term "." "size" | memory_storage_3_term "." "end" | memory_storage_3_term "." "align" | memory_storage_3_term "." "readable_size" | memory_storage_3_term "." "writable_size" | memory_storage_9_term "." "start" | memory_storage_9_term "." "size" | memory_storage_9_term "." "end" | memory_storage_9_term "." "align" | memory_storage_9_term "." "readable_size" | memory_storage_9_term "." "writable_size" | memory_storage_4_term "." "start" | memory_storage_4_term "." "size" | memory_storage_4_term "." "end" | memory_storage_4_term "." "align" | memory_storage_4_term "." "readable_size" | memory_storage_4_term "." "writable_size" | memory_storage_6_term "." "start" | memory_storage_6_term "." "size" | memory_storage_6_term "." "end" | memory_storage_6_term "." "align" | memory_storage_6_term "." "readable_size" | memory_storage_6_term "." "writable_size" | memory_storage_7_term "." "start" | memory_storage_7_term "." "size" | memory_storage_7_term "." "end" | memory_storage_7_term "." "align" | memory_storage_7_term "." "readable_size" | memory_storage_7_term "." "writable_size" | memory_allocation_term "." "start" | memory_allocation_term "." "size" | memory_allocation_term "." "end" | memory_allocation_term "." "align" | memory_allocation_term "." "minimum_size" | memory_storage_1_term "." "start" | memory_storage_1_term "." "size" | memory_storage_1_term "." "end" | memory_storage_1_term "." "align" | memory_storage_1_term "." "readable_size" | memory_storage_1_term "." "writable_size" | memory_storage_5_term "." "start" | memory_storage_5_term "." "size" | memory_storage_5_term "." "end" | memory_storage_5_term "." "align" | memory_storage_5_term "." "readable_size" | memory_storage_5_term "." "writable_size" | memory_storage_2_term "." "start" | memory_storage_2_term "." "size" | memory_storage_2_term "." "end" | memory_storage_2_term "." "align" | memory_storage_2_term "." "readable_size" | memory_storage_2_term "." "writable_size" | "(" memory_integer_term ")")
memory_storage_1_term: (q_term "." "$mem" | "(" memory_storage_1_term ")")
memory_storage_2_term: (v_term "." "$mem" | "(" memory_storage_2_term ")")
memory_storage_3_term: (sequence_1_term "." "$mem" | "(" memory_storage_3_term ")")
memory_storage_4_term: (sequence_2_term "." "$mem" | "(" memory_storage_4_term ")")
memory_storage_5_term: (some_term "." "$mem" | "(" memory_storage_5_term ")")
memory_storage_6_term: (option_term "." "$mem" | "(" memory_storage_6_term ")")
memory_storage_7_term: (hash_map_1_term "." "$mem" | "(" memory_storage_7_term ")")
memory_storage_8_term: (hash_map_2_term "." "$mem" | "(" memory_storage_8_term ")")
memory_storage_9_term: (usize_term "." "$mem" | "(" memory_storage_9_term ")")
memory_string_term: (memory_allocation_term "." "id" | memory_allocation_term "." "allocator" | "(" memory_string_term ")")
q_term: (sequence_1_term "[" index "]" | "(" q_term ")")
v_term: (some_term "[" "0" "]" | "(" v_term ")")
sequence_1_term: ("$2" | "(" sequence_1_term ")")
sequence_2_term: ("$8" | "(" sequence_2_term ")")
some_term: (option_term "." "Some" | "(" some_term ")")
option_term: ("a" | "b" | sequence_2_term "[" index "]" | "(" option_term ")")
option_variant: ("\"None\"" | "'None'" | "\"Some\"" | "'Some'")
option_test: "is_variant" "(" option_term "," option_variant ")"
hash_map_1_term: (hash_map_2_term "." "base" | "(" hash_map_1_term ")")
hash_map_2_term: ("$1" | "(" hash_map_2_term ")")
opaque_1_term: ("$3" | "(" opaque_1_term ")")
opaque_2_term: ("$6" | "(" opaque_2_term ")")
opaque_3_term: ("$5" | "(" opaque_3_term ")")
opaque_4_term: ("$4" | "(" opaque_4_term ")")
usize_term: ("$7" | "(" usize_term ")")
typed_term: (memory_allocation_term | memory_bool_term | memory_integer_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_storage_7_term | memory_storage_8_term | memory_storage_9_term | memory_string_term | q_term | v_term | sequence_1_term | sequence_2_term | some_term | option_term | hash_map_1_term | hash_map_2_term | opaque_1_term | opaque_2_term | opaque_3_term | opaque_4_term | usize_term)
variant_test: (option_test)
formula: expression
expression: disjunction ("if" disjunction "else" expression)?
disjunction: conjunction ("or" conjunction)*
conjunction: negation ("and" negation)*
negation: ("not" negation | comparison)
comparison: arithmetic (compare arithmetic)*
compare: ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in")
arithmetic: product (("+" | "-") product)*
product: unary (("*" | "//" | "%") unary)*
unary: (("+" | "-"))? primary
primary: (typed_term | integer | string | "True" | "False" | "None" | "(" expression ")" | collection | builtin)
collection: ("[" (expression ("," expression)*)? "]" | "[" expression comprehension "]")
comprehension: "for" identifier "in" disjunction ("if" disjunction)* (comprehension)?
builtin: (("all" | "any") "(" expression ")" | "len" "(" expression ")" | variant_test)
index: index_product (("+" | "-") index_product)*
index_product: index_unary (("*" | "//" | "%") index_unary)*
index_unary: (("+" | "-"))? index_primary
index_primary: (integer | "(" index ")" | "len" "(" expression ")" | memory_integer_term | usize_term)
identifier: IDENTIFIER
integer: INTEGER
string: STRING
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
INTEGER: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
%import common.WS
%ignore WS
