(* marker::PhantomData *)
phantom_data_term = (once_lock_term, ".", "_marker" | "(", phantom_data_term, ")") ;
(* std::sync::once_lock::OnceLock<T> *)
once_lock_term = ("$1" | "(", once_lock_term, ")") ;
(* std::sync::poison::once::Once *)
once_1_term = (once_lock_term, ".", "once" | "(", once_1_term, ")") ;
(* sys::sync::Once *)
once_2_term = (once_1_term, ".", "inner" | "(", once_2_term, ")") ;
(* type parameter T *)
opaque_term = ("$2" | "(", opaque_term, ")") ;
typed_term = (memory_allocation_term | memory_bool_term | memory_integer_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_storage_6_term | memory_string_term | t_term | unsafe_cell_term | phantom_data_term | once_lock_term | once_1_term | once_2_term | opaque_term) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")") ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
