(* MemoryStorage<T> *)
memory_storage_1_term = (t_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<cell::UnsafeCell> *)
memory_storage_2_term = (unsafe_cell_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<marker::PhantomData> *)
