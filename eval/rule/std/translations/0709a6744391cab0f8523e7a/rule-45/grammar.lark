raw_handle_term: ("$1" | borrowed_handle_term "." "handle" | "(" raw_handle_term ")")
memory_storage_1_term: (raw_handle_term "." "$mem" | "(" memory_storage_1_term ")")
memory_storage_2_term: (borrowed_handle_term "." "$mem" | "(" memory_storage_2_term ")")
phantom_data_term: (borrowed_handle_term "." "_phantom" | "(" phantom_data_term ")")
borrowed_handle_term: ("$2" | "(" borrowed_handle_term ")")
typed_term: (raw_handle_term | memory_storage_1_term | memory_storage_2_term | phantom_data_term | borrowed_handle_term)
formula: expression
expression: disjunction ("if" disjunction "else" expression)?
disjunction: conjunction ("or" conjunction)*
conjunction: negation ("and" negation)*
negation: ("not" negation | comparison)
comparison: arithmetic (compare arithmetic)*
compare: ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in")
arithmetic: product (("+" | "-") product)*
product: unary (("*" | "//" | "%") unary)*
unary: (("+" | "-"))? primary
primary: (typed_term | integer | string | "True" | "False" | "None" | "(" expression ")" | collection | builtin)
collection: ("[" (expression ("," expression)*)? "]" | "[" expression comprehension "]")
comprehension: "for" identifier "in" disjunction ("if" disjunction)* (comprehension)?
builtin: (("all" | "any") "(" expression ")" | "len" "(" expression ")")
identifier: IDENTIFIER
integer: INTEGER
string: STRING
IDENTIFIER: /[A-Za-z_][A-Za-z0-9_]*/
INTEGER: /[0-9]+/
STRING: /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/
%import common.WS
%ignore WS
