| memory_storage_2_term "." "valid" | memory_storage_9_term "." "exists" | memory_storage_9_term "." "readable" | memory_storage_9_term "." "writable" | memory_storage_9_term "." "initialized" | memory_storage_9_term "." "valid" | memory_region_term "." "exists" | memory_region_term "." "readable" | memory_region_term "." "writable" | memory_region_term "." "initialized" | memory_region_term "." "valid" | memory_storage_1_term "." "exists" | memory_storage_1_term "." "readable" | memory_storage_1_term "." "writable" | memory_storage_1_term "." "initialized" | memory_storage_1_term "." "valid" | "(" memory_bool_term ")")
memory_integer_term: (memory_storage_12_term "." "start" | memory_storage_12_term "." "size" | memory_storage_12_term "." "end" | memory_storage_12_term "." "align" | memory_storage_12_term "." "readable_size" | memory_storage_12_term "." "writable_size" | memory_storage_6_term "." "start" | memory_storage_6_term "." "size" | memory_storage_6_term "." "end" | memory_storage_6_term "." "align" | memory_storage_6_term "." "readable_size" | memory_storage_6_term "." "writable_size" | memory_storage_3_term "." "start" | memory_storage_3_term "." "size" | memory_storage_3_term "." "end" | memory_storage_3_term "." "align" | memory_storage_3_term "." "readable_size" | memory_storage_3_term "." "writable_size" | memory_allocation_term "." "start" | memory_allocation_term "." "size" | memory_allocation_term "." "end" | memory_allocation_term "." "align" | memory_allocation_term "." "minimum_size" | memory_storage_4_term "." "start" | memory_storage_4_term "." "size" | memory_storage_4_term "." "end" | memory_storage_4_term "." "align" | memory_storage_4_term "." "readable_size" | memory_storage_4_term "." "writable_size" | memory_storage_11_term "." "start" | memory_storage_11_term "." "size" | memory_storage_11_term "." "end" | memory_storage_11_term "." "align" | memory_storage_11_term "." "readable_size" | memory_storage_11_term "." "writable_size" | memory_storage_5_term "." "start" | memory_storage_5_term "." "size" | memory_storage_5_term "." "end" | memory_storage_5_term "." "align" | memory_storage_5_term "." "readable_size" | memory_storage_5_term "." "writable_size" | memory_storage_7_term "." "start" | memory_storage_7_term "." "size" | memory_storage_7_term "." "end" | memory_storage_7_term "." "align" | memory_storage_7_term "." "readable_size" | memory_storage_7_term "." "writable_size" | memory_storage_10_term "." "start" | memory_storage_10_term "." "size" | memory_storage_10_term "." "end" | memory_storage_10_term "." "align" | memory_storage_10_term "." "readable_size" | memory_storage_10_term "." "writable_size" | memory_storage_8_term "." "start" | memory_storage_8_term "." "size" | memory_storage_8_term "." "end" | memory_storage_8_term "." "align" | memory_storage_8_term "." "readable_size" | memory_storage_8_term "." "writable_size" | memory_storage_2_term "." "start" | memory_storage_2_term "." "size" | memory_storage_2_term "." "end" | memory_storage_2_term "." "align" | memory_storage_2_term "." "readable_size" | memory_storage_2_term "." "writable_size" | memory_storage_9_term "." "start" | memory_storage_9_term "." "size" | memory_storage_9_term "." "end" | memory_storage_9_term "." "align" | memory_storage_9_term "." "readable_size" | memory_storage_9_term "." "writable_size" | memory_region_term "." "start" | memory_region_term "." "size" | memory_region_term "." "end" | memory_region_term "." "align" | memory_region_term "." "readable_size" | memory_region_term "." "writable_size" | memory_storage_1_term "." "start" | memory_storage_1_term "." "size" | memory_storage_1_term "." "end" | memory_storage_1_term "." "align" | memory_storage_1_term "." "readable_size" | memory_storage_1_term "." "writable_size" | "(" memory_integer_term ")")
