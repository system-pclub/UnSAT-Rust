(* Generated concrete EBNF. Every field, tuple position and enum tag is a literal. *)
(* $1 is nr: core::num::nonzero::NonZero < u64 > [argument]. *)
(* $2 is p1: u64 [argument]. *)
(* $3 is p2: u64 [argument]. *)
(* $4 is p3: u64 [argument]. *)
(* $5 is p4: u64 [argument]. *)
(* $6 is abort: bool [argument]. *)
(* $7 is result: (u64 , u64) [return_value]. *)
(* Bare identifier entries are comprehension locals only; scope and element types are checked separately. *)

(* (u64, u64) *)
tuple_term = ("$7" | "(", tuple_term, ")") ;
(* MemoryAllocation *)
memory_allocation_term = (memory_storage_4_term, ".", "allocation" | memory_storage_5_term, ".", "allocation" | memory_storage_3_term, ".", "allocation" | memory_storage_1_term, ".", "allocation" | memory_storage_2_term, ".", "allocation" | "(", memory_allocation_term, ")") ;
(* MemoryBool *)
memory_bool_term = (memory_storage_4_term, ".", "exists" | memory_storage_4_term, ".", "readable" | memory_storage_4_term, ".", "writable" | memory_storage_4_term, ".", "initialized" | memory_storage_4_term, ".", "valid" | memory_storage_5_term, ".", "exists" | memory_storage_5_term, ".", "readable" | memory_storage_5_term, ".", "writable" | memory_storage_5_term, ".", "initialized" | memory_storage_5_term, ".", "valid" | memory_storage_3_term, ".", "exists" | memory_storage_3_term, ".", "readable" | memory_storage_3_term, ".", "writable" | memory_storage_3_term, ".", "initialized" | memory_storage_3_term, ".", "valid" | memory_storage_1_term, ".", "exists" | memory_storage_1_term, ".", "readable" | memory_storage_1_term, ".", "writable" | memory_storage_1_term, ".", "initialized" | memory_storage_1_term, ".", "valid" | memory_storage_2_term, ".", "exists" | memory_storage_2_term, ".", "readable" | memory_storage_2_term, ".", "writable" | memory_storage_2_term, ".", "initialized" | memory_storage_2_term, ".", "valid" | memory_allocation_term, ".", "exists" | memory_allocation_term, ".", "live" | "(", memory_bool_term, ")") ;
(* MemoryInteger *)
memory_integer_term = (memory_storage_4_term, ".", "start" | memory_storage_4_term, ".", "size" | memory_storage_4_term, ".", "end" | memory_storage_4_term, ".", "align" | memory_storage_4_term, ".", "readable_size" | memory_storage_4_term, ".", "writable_size" | memory_storage_5_term, ".", "start" | memory_storage_5_term, ".", "size" | memory_storage_5_term, ".", "end" | memory_storage_5_term, ".", "align" | memory_storage_5_term, ".", "readable_size" | memory_storage_5_term, ".", "writable_size" | memory_storage_3_term, ".", "start" | memory_storage_3_term, ".", "size" | memory_storage_3_term, ".", "end" | memory_storage_3_term, ".", "align" | memory_storage_3_term, ".", "readable_size" | memory_storage_3_term, ".", "writable_size" | memory_storage_1_term, ".", "start" | memory_storage_1_term, ".", "size" | memory_storage_1_term, ".", "end" | memory_storage_1_term, ".", "align" | memory_storage_1_term, ".", "readable_size" | memory_storage_1_term, ".", "writable_size" | memory_storage_2_term, ".", "start" | memory_storage_2_term, ".", "size" | memory_storage_2_term, ".", "end" | memory_storage_2_term, ".", "align" | memory_storage_2_term, ".", "readable_size" | memory_storage_2_term, ".", "writable_size" | memory_allocation_term, ".", "start" | memory_allocation_term, ".", "size" | memory_allocation_term, ".", "end" | memory_allocation_term, ".", "align" | memory_allocation_term, ".", "minimum_size" | "(", memory_integer_term, ")") ;
(* MemoryStorage<(u64, u64)> *)
memory_storage_1_term = (tuple_term, ".", "$mem" | "(", memory_storage_1_term, ")") ;
(* MemoryStorage<T::NonZeroInner> *)
memory_storage_2_term = (non_zero_inner_term, ".", "$mem" | "(", memory_storage_2_term, ")") ;
(* MemoryStorage<bool> *)
memory_storage_3_term = (bool_term, ".", "$mem" | "(", memory_storage_3_term, ")") ;
(* MemoryStorage<core::num::nonzero::NonZero<T>> *)
memory_storage_4_term = (non_zero_term, ".", "$mem" | "(", memory_storage_4_term, ")") ;
(* MemoryStorage<u64> *)
memory_storage_5_term = (u64_term, ".", "$mem" | "(", memory_storage_5_term, ")") ;
(* MemoryString *)
memory_string_term = (memory_allocation_term, ".", "id" | memory_allocation_term, ".", "allocator" | "(", memory_string_term, ")") ;
(* T::NonZeroInner *)
non_zero_inner_term = (non_zero_term, "[", "0", "]" | "(", non_zero_inner_term, ")") ;
(* bool *)
bool_term = ("$6" | "(", bool_term, ")") ;
(* core::num::nonzero::NonZero<T> *)
non_zero_term = ("$1" | "(", non_zero_term, ")") ;
(* u64 *)
u64_term = ("$2" | "$3" | "$4" | "$5" | tuple_term, "[", "0", "]" | tuple_term, "[", "1", "]" | "(", u64_term, ")") ;
typed_term = (tuple_term | memory_allocation_term | memory_bool_term | memory_integer_term | memory_storage_1_term | memory_storage_2_term | memory_storage_3_term | memory_storage_4_term | memory_storage_5_term | memory_string_term | non_zero_inner_term | bool_term | non_zero_term | u64_term) ;
formula = expression ;
expression = disjunction, [ "if", disjunction, "else", expression ] ;
disjunction = conjunction, { "or", conjunction } ;
conjunction = negation, { "and", negation } ;
negation = ("not", negation | comparison) ;
comparison = arithmetic, { compare, arithmetic } ;
compare = ("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not", "in") ;
arithmetic = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "//" | "%"), unary } ;
unary = [ ("+" | "-") ], primary ;
primary = (typed_term | integer | string | "True" | "False" | "None" | "(", expression, ")" | collection | builtin) ;
collection = ("[", [ expression, { ",", expression } ], "]" | "[", expression, comprehension, "]") ;
comprehension = "for", identifier, "in", disjunction, { "if", disjunction }, [ comprehension ] ;
builtin = (("all" | "any"), "(", expression, ")" | "len", "(", expression, ")") ;
identifier = ? ASCII identifier [A-Za-z_][A-Za-z0-9_]* ? ;
integer = ? nonnegative decimal integer literal ? ;
string = ? single- or double-quoted escaped string literal ? ;
