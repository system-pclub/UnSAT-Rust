FROM rust@sha256:540c902e99c384163b688bbd8b5b8520e94e7731b27f7bd0eaa56ae1960627ab
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates curl git cmake clang-15 libclang-15-dev llvm-15-dev lld-15 libcapstone-dev pkg-config unzip openjdk-17-jre-headless libgmp-dev libmpfr-dev libppl-dev libz3-dev m4 python3 && rm -rf /var/lib/apt/lists/*
ENV LIBCLANG_PATH=/usr/lib/llvm-15/lib
ENV CARGO_BUILD_JOBS=4
WORKDIR /work
