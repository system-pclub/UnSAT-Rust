FROM uspec-rust-comparison-base:bookworm
ARG PRUSTI_VERSION=v-2024-03-26-1504
RUN curl -fL --retry 3 "https://github.com/viperproject/prusti-dev/releases/download/${PRUSTI_VERSION}/prusti-release-ubuntu.zip" -o /tmp/prusti.zip && mkdir /opt/prusti && unzip -q /tmp/prusti.zip -d /opt/prusti && rm /tmp/prusti.zip && chmod +x /opt/prusti/prusti-* /opt/prusti/cargo-prusti
RUN rustup toolchain install nightly-2023-09-15 --profile minimal --component rustc-dev --component llvm-tools-preview
ENV RUSTUP_TOOLCHAIN=nightly-2023-09-15
ENV PATH=/opt/prusti:$PATH
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
WORKDIR /work
