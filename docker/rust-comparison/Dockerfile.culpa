FROM uspec-rust-comparison-base:bookworm
ARG REVISION=4cf5c9e8e6af5f4f0e4cd97bf7428c570ac9be68
RUN git clone https://github.com/shinmao/culpa.git /opt/culpa && cd /opt/culpa && git checkout "$REVISION"
RUN rustup toolchain install nightly-2025-02-20 --profile minimal --component rustc-dev --component rust-src --component llvm-tools-preview
ENV RUSTUP_TOOLCHAIN=nightly-2025-02-20
ENV LD_LIBRARY_PATH=/usr/local/rustup/toolchains/nightly-2025-02-20-x86_64-unknown-linux-gnu/lib
ENV CULPA_SPECS_DIR=/opt/culpa/culpa/specs
WORKDIR /opt/culpa/culpa
RUN RUSTFLAGS="-A warnings" cargo install --locked --path .
RUN mv /usr/local/cargo/bin/culpa /usr/local/cargo/bin/culpa-driver
COPY culpa-driver.sh /usr/local/cargo/bin/culpa
RUN chmod +x /usr/local/cargo/bin/culpa
LABEL org.opencontainers.image.source="https://github.com/shinmao/culpa"
LABEL org.opencontainers.image.revision="${REVISION}"
WORKDIR /work
