-use rustc_middle::ty::{Ty, TyCtxt, TyKind, TypingEnv};
+use rustc_middle::ty::{Ty, TyCtxt, TyKind, TypingEnv, TypeVisitableExt};
+
+/// Query concrete layout only when the fully-monomorphized environment applies.
+/// Generic layouts remain unknown; querying them with an empty parameter
+/// environment can register a delayed rustc ICE even when layout_of returns Err.
+pub fn try_layout_of<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    ty: Ty<'tcx>,
+) -> Result<rustc_middle::ty::layout::TyAndLayout<'tcx>, ()> {
+    if ty.has_non_region_param() || ty.has_infer() || ty.has_escaping_bound_vars() {
+        return Err(());
+    }
+    tcx.layout_of(TypingEnv::fully_monomorphized().as_query_input(ty))
+        .map_err(|_| ())
+}
+
+/// Const generics cannot be evaluated without their defining parameter environment.
+/// Preserve the existing unknown-value fallback instead of panicking in rustc.
+pub fn try_eval_usize<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    constant: rustc_middle::mir::Const<'tcx>,
+) -> Option<u64> {
+    if !matches!(constant.ty().kind(), TyKind::Uint(rustc_middle::ty::UintTy::Usize))
+        || constant.has_non_region_param()
+        || constant.has_infer()
+        || constant.has_escaping_bound_vars()
+    {
+        return None;
+    }
+    constant.try_eval_target_usize(tcx, TypingEnv::fully_monomorphized())
+}
 
