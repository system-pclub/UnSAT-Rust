FROM uspec-rust-comparison-base:bookworm
ARG REVISION=cc78cb72cb85cb80e596717339cca95ef50c8fe0
RUN git clone https://github.com/BurtonQin/lockbud.git /opt/lockbud && cd /opt/lockbud && git checkout "$REVISION"
RUN rustup toolchain install nightly-2026-02-07 --profile minimal --component rustc-dev --component rust-src --component llvm-tools-preview
ENV RUSTUP_TOOLCHAIN=nightly-2026-02-07
ENV LD_LIBRARY_PATH=/usr/local/rustup/toolchains/nightly-2026-02-07-x86_64-unknown-linux-gnu/lib
WORKDIR /opt/lockbud
RUN cargo install --locked --path .
WORKDIR /work
