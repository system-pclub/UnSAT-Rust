          "k": "attr",
          "base": {
            "k": "attr",
            "base": {
              "k": "mem",
              "base": {
                "k": "slot",
                "n": 1
              }
            },
            "name": "pointee"
          },
          "name": "initialized"
        }
      },
      "generated_rule": "core:rule-660",
      "api": "const unsafe fn read < T > (src : * const T) -> T",
      "case": "memory-state",
      "note": "Synthetic byte-initialization observation regression, including padding; distinct from ptr::read's typed-validity contract."
