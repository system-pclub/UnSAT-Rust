        "dsl_version": 2,
        "source": "$1.$mem.pointee.initialized",
        "slots": [
          {
            "slot": 1,
            "name": "src",
            "kind": "argument",
            "rust_type": "* const T",
            "arg_index": 0
          },
          {
            "slot": 2,
            "name": "T",
            "kind": "type_parameter",
            "rust_type": "type metadata",
            "generic_index": 0
          },
          {
            "slot": 3,
            "name": "result",
            "kind": "return_value",
            "rust_type": "T"
          }
        ],
