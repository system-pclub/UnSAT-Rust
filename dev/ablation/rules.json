{
  "rules": {
    "rule-321": {
      "path": "rust/library/core/src/ptr/mod.rs:1231",
      "name": "const unsafe fn read < T >",
      "rule": "`src` must be valid for reads.",
      "dsl": "$1.$mem.pointee.readable",
      "dsl_v2": {
        "dsl_version": 2,
        "source": "$1.$mem.pointee.readable",
        "slots": [
          {
            "slot": 1,
            "name": "src",
            "kind": "argument",
            "rust_type": "* const T",
            "arg_index": 0
          },
          {
            "slot": 2,
            "name": "T",
            "kind": "type_parameter",
            "rust_type": "type metadata",
            "generic_index": 0
          },
          {
            "slot": 3,
            "name": "result",
            "kind": "return_value",
            "rust_type": "T"
          }
        ],
        "uses_result": false,
        "expr": {
          "k": "attr",
          "base": {
            "k": "attr",
            "base": {
              "k": "mem",
              "base": {
                "k": "slot",
                "n": 1
              }
            },
            "name": "pointee"
          },
          "name": "readable"
        }
      },
      "generated_rule": "core:rule-656",
      "api": "const unsafe fn read < T > (src : * const T) -> T",
      "case": "raw-slices"
    }
  }
}
